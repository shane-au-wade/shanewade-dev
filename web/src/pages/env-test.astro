---
// env test page to test the environment variables injection in deno deploy
---

<html lang="en">
    <head>
        <title>Env Test</title>
    </head>
    <body class="bg-page dark:bg-dark-bg min-h-screen p-8">
        <div class="container py-8 card">
            <h1 class="heading-1">Env Test</h1>
            <p id="public-test-var" class="text-leading">PUBLIC_TEST_VAR:</p>
            <p id="supabase-url" class="text-leading">SUPABASE_URL:</p>
            <p id="supabase-anon-key" class="text-leading">SUPABASE_ANON_KEY:</p>
        </div>
    </body>
</html>

<script>
    const publicTestVarElement = document.getElementById("public-test-var");
    if (publicTestVarElement) {
        publicTestVarElement.textContent =
            "PUBLIC_TEST_VAR: " + import.meta.env.PUBLIC_TEST_VAR;
    }
    const supabaseUrlElement = document.getElementById("supabase-url");
    if (supabaseUrlElement) {
        supabaseUrlElement.textContent = "SUPABASE_URL: " + import.meta.env.PUBLIC_SUPABASE_URL;
    }
    const supabaseAnonKeyElement = document.getElementById("supabase-anon-key");
    if (supabaseAnonKeyElement) {
        supabaseAnonKeyElement.textContent = "SUPABASE_ANON_KEY: " + import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    }
</script>
