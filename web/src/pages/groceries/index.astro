---
import groceryListData from "./grocery-list.json";

const asNeededGroceries: Record<string, string> = {};
const groceries: Record<string, string> = {};
Object.entries(groceryListData).forEach(([key, value]) => {
    if (value.toLowerCase().includes("as needed")) {
        asNeededGroceries[key] = value;
        return;
    }
    groceries[key] = value;
});

// Sort items alphabetically
const sortedGroceries = Object.entries(groceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const sortedAsNeededGroceries = Object.entries(asNeededGroceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const totalItems = sortedGroceries.length + sortedAsNeededGroceries.length;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Grocery List</title>
        <style>
            @import "../../styles/colors.css";

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                    Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue",
                    sans-serif;
                background: var(--color-bg-secondary);
                color: var(--color-text-primary);
                padding: 0;
                margin: 0;
                min-height: 100vh;
            }

            .container {
                max-width: 600px;
                margin: 0 auto;
                padding: 1rem;
            }

            .header {
                background: var(--color-white);
                border-radius: 12px;
                padding: 1.5rem;
                margin-bottom: 1rem;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            }

            .header h1 {
                font-size: 2rem;
                margin-bottom: 0.5rem;
                color: var(--color-brand-primary);
            }

            .stats {
                display: flex;
                gap: 1rem;
                font-size: 0.875rem;
                color: var(--color-text-secondary);
                margin-top: 1rem;
            }

            .stat {
                display: flex;
                align-items: center;
                gap: 0.25rem;
            }

            .stat-value {
                font-weight: 600;
                color: var(--color-text-primary);
            }

            .actions {
                display: flex;
                gap: 0.5rem;
                margin-top: 1rem;
            }

            .btn {
                flex: 1;
                padding: 0.625rem 1rem;
                border: none;
                border-radius: 8px;
                font-size: 0.875rem;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.2s;
            }

            .btn-primary {
                background: var(--color-brand-primary);
                color: white;
            }

            .btn-primary:hover {
                background: var(--color-brand-primary-hover);
            }

            .btn-secondary {
                background: white;
                color: var(--color-text-primary);
                border: 1px solid var(--color-border-medium);
            }

            .btn-secondary:hover {
                background: var(--color-bg-secondary);
            }

            .grocery-list {
                background: var(--color-white);
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            }

            .grocery-item {
                display: flex;
                align-items: center;
                padding: 1rem;
                border-bottom: 1px solid var(--color-border-light);
                transition: background 0.2s;
            }

            .grocery-item:last-child {
                border-bottom: none;
            }

            .grocery-item:hover {
                background: var(--color-bg-secondary);
            }

            .grocery-item.checked {
                opacity: 0.5;
            }

            .grocery-item.checked .item-name,
            .grocery-item.checked .item-quantity {
                text-decoration: line-through;
            }

            .checkbox-wrapper {
                position: relative;
                margin-right: 1rem;
                flex-shrink: 0;
            }

            .checkbox {
                width: 24px;
                height: 24px;
                border: 2px solid var(--color-gray-300);
                border-radius: 6px;
                cursor: pointer;
                appearance: none;
                transition: all 0.2s;
                background: white;
            }

            .checkbox:checked {
                background: var(--color-brand-primary);
                border-color: var(--color-brand-primary);
            }

            .checkbox:checked::after {
                content: "✓";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                color: white;
                font-size: 16px;
                font-weight: bold;
            }

            .item-content {
                flex: 1;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
            }

            .item-name {
                font-size: 1rem;
                color: var(--color-text-primary);
                font-weight: 500;
            }

            .item-quantity {
                font-size: 0.875rem;
                color: var(--color-text-secondary);
                white-space: nowrap;
            }

            .empty-state {
                padding: 3rem 1rem;
                text-align: center;
                color: var(--color-text-secondary);
            }

            .empty-state-icon {
                font-size: 3rem;
                margin-bottom: 1rem;
            }

            @media (max-width: 480px) {
                .container {
                    padding: 0.5rem;
                }

                .header {
                    padding: 1rem;
                    margin-bottom: 0.5rem;
                }

                .header h1 {
                    font-size: 1.5rem;
                }

                .grocery-item {
                    padding: 0.75rem;
                }

                .item-name {
                    font-size: 0.9375rem;
                }

                .item-quantity {
                    font-size: 0.8125rem;
                }
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">
                <h1>Grocery List</h1>
                <div class="stats">
                    <div class="stat">
                        <span class="stat-value" id="checked-count">0</span>
                        <span>/</span>
                        <span>{totalItems}</span>
                        <span>items</span>
                    </div>
                </div>
                <div class="actions">
                    <button class="btn btn-secondary" id="clear-checked"
                        >Clear Checked</button
                    >
                    <button class="btn btn-primary" id="reset-all"
                        >Reset All</button
                    >
                </div>
            </div>

            {
                sortedGroceries.length === 0 ? (
                    <div class="grocery-list">
                        <div class="empty-state">
                            <div class="empty-state-icon">🛒</div>
                            <p>Your grocery list is empty</p>
                        </div>
                    </div>
                ) : (
                    <div class="grocery-list">
                        {sortedGroceries.map(([name, quantity]) => (
                            <div class="grocery-item">
                                <div class="checkbox-wrapper">
                                    <input
                                        type="checkbox"
                                        class="checkbox"
                                        id={`item-${name}`}
                                        data-item={name}
                                    />
                                </div>
                                <label
                                    for={`item-${name}`}
                                    class="item-content"
                                >
                                    <span class="item-name">{name}</span>
                                    <span class="item-quantity">
                                        {quantity}
                                    </span>
                                </label>
                            </div>
                        ))}
                    </div>
                )
            }

            <!-- this is hacky, need to rethink this rendering logic -->
            {
                sortedAsNeededGroceries.length === 0 ? (
                    <div class="grocery-list">
                        <div class="empty-state">
                            <div class="empty-state-icon">🛒</div>
                            <p>Your grocery list is empty</p>
                        </div>
                    </div>
                ) : (
                    <div class="grocery-list">
                        {sortedAsNeededGroceries.map(([name, quantity]) => (
                            <div class="grocery-item">
                                <div class="checkbox-wrapper">
                                    <input
                                        type="checkbox"
                                        class="checkbox"
                                        id={`item-${name}`}
                                        data-item={name}
                                    />
                                </div>
                                <label
                                    for={`item-${name}`}
                                    class="item-content"
                                >
                                    <span class="item-name">{name}</span>
                                    <span class="item-quantity">
                                        {quantity}
                                    </span>
                                </label>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>

        <script>
            // Local storage key
            const STORAGE_KEY = "grocery-list-checked";

            // Load checked items from localStorage
            function loadCheckedItems(): Set<string> {
                try {
                    const stored = localStorage.getItem(STORAGE_KEY);
                    return stored ? new Set(JSON.parse(stored)) : new Set();
                } catch (e) {
                    console.error("Failed to load checked items:", e);
                    return new Set();
                }
            }

            // Save checked items to localStorage
            function saveCheckedItems(checkedItems: Set<string>) {
                try {
                    localStorage.setItem(
                        STORAGE_KEY,
                        JSON.stringify(Array.from(checkedItems)),
                    );
                } catch (e) {
                    console.error("Failed to save checked items:", e);
                }
            }

            // Update the checked count display
            function updateCheckedCount(count: number) {
                const countElement = document.getElementById("checked-count");
                if (countElement) {
                    countElement.textContent = count.toString();
                }
            }

            // Initialize on page load
            function init() {
                const checkedItems = loadCheckedItems();
                const checkboxes =
                    document.querySelectorAll<HTMLInputElement>(".checkbox");

                // Restore checked state
                checkboxes.forEach((checkbox) => {
                    const itemName = checkbox.dataset.item;
                    if (itemName && checkedItems.has(itemName)) {
                        checkbox.checked = true;
                        checkbox
                            .closest(".grocery-item")
                            ?.classList.add("checked");
                    }
                });

                updateCheckedCount(checkedItems.size);

                // Add event listeners to checkboxes
                checkboxes.forEach((checkbox) => {
                    checkbox.addEventListener("change", (e) => {
                        const target = e.target as HTMLInputElement;
                        const itemName = target.dataset.item;
                        const item = target.closest(".grocery-item");

                        if (!itemName || !item) return;

                        if (target.checked) {
                            checkedItems.add(itemName);
                            item.classList.add("checked");
                        } else {
                            checkedItems.delete(itemName);
                            item.classList.remove("checked");
                        }

                        saveCheckedItems(checkedItems);
                        updateCheckedCount(checkedItems.size);
                    });
                });

                // Clear checked items button
                const clearCheckedBtn =
                    document.getElementById("clear-checked");
                clearCheckedBtn?.addEventListener("click", () => {
                    const checkedCheckboxes =
                        document.querySelectorAll<HTMLInputElement>(
                            ".checkbox:checked",
                        );
                    checkedCheckboxes.forEach((checkbox) => {
                        checkbox.checked = false;
                        checkbox
                            .closest(".grocery-item")
                            ?.classList.remove("checked");
                        const itemName = checkbox.dataset.item;
                        if (itemName) {
                            checkedItems.delete(itemName);
                        }
                    });
                    saveCheckedItems(checkedItems);
                    updateCheckedCount(0);
                });

                // Reset all button
                const resetAllBtn = document.getElementById("reset-all");
                resetAllBtn?.addEventListener("click", () => {
                    checkboxes.forEach((checkbox) => {
                        checkbox.checked = false;
                        checkbox
                            .closest(".grocery-item")
                            ?.classList.remove("checked");
                    });
                    checkedItems.clear();
                    saveCheckedItems(checkedItems);
                    updateCheckedCount(0);
                });
            }

            // Run initialization when DOM is ready
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init);
            } else {
                init();
            }
        </script>
    </body>
</html>
