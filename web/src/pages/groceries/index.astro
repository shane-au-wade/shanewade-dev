---
import { supabase } from "../../lib/db/supabase-client";
import {
    getRecipe,
    getGroceryListFromRecipes,
    type Recipe,
} from "@shared/recipes/queries";
import RecipesModal from "../../components/recipes-modal.astro";
import "@styles/components.css";
import 'remixicon/fonts/remixicon.css'


// Check for recipe IDs in URL params
const url = new URL(Astro.request.url);
const recipesParam = url.searchParams.get("recipes");

let groceryListData: Record<string, string> = {};
let recipeCount = 0;
let errorMessage = "";
let recipes: Recipe[] = [];

if (recipesParam) {
    // Parse recipe IDs from URL
    const recipeIds = recipesParam
        .split(",")
        .map((id) => id.trim())
        .filter(Boolean);
    recipeCount = recipeIds.length;

    if (recipeIds.length > 0) {
        try {
            // Fetch all recipes
            const recipePromises = recipeIds.map((id) =>
                getRecipe(supabase, id),
            );
            recipes = await Promise.all(recipePromises);

            // Generate grocery list from recipes
            groceryListData = getGroceryListFromRecipes(recipes);
        } catch (error) {
            console.error("Error fetching recipes:", error);
            errorMessage =
                error instanceof Error
                    ? error.message
                    : "Failed to fetch recipes";
        }
    }
}

// Separate "as needed" items from quantified items
const asNeededGroceries: Record<string, string> = {};
const groceries: Record<string, string> = {};
Object.entries(groceryListData).forEach(([key, value]) => {
    if (value.toLowerCase().includes("as needed")) {
        asNeededGroceries[key] = value;
        return;
    }
    groceries[key] = value;
});

// Sort items alphabetically
const sortedGroceries = Object.entries(groceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const sortedAsNeededGroceries = Object.entries(asNeededGroceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const totalItems = sortedGroceries.length + sortedAsNeededGroceries.length;
---

<style>
    .grocery-item.checked {
        opacity: 0.5;
    }

    .grocery-item.checked .item-name,
    .grocery-item.checked .item-quantity {
        text-decoration: line-through;
    }
</style>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Grocery List</title>
    </head>
    <body class="bg-page dark:bg-dark-bg min-h-screen">
        <div class="container py-4 max-w-2xl">
            <button
            class="btn-ghost btn-sm"
            onclick="window.location.href='/recipes/composer'"
            ><i class="ri-add-line"></i> New Grocery List
        </button>
            <div class="card mb-4">
                <div class="card-body">
                    <h1 class="heading-2 mb-2">Grocery List</h1>
                    {
                        recipeCount > 0 && (
                            <p class="text-muted mb-4">
                                {/* do not adjust this line  */}
                                From {recipeCount} recipe
                                {recipeCount !== 1 ? "s" : ""}
                            </p>
                        )
                    }
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-body font-semibold" id="checked-count"
                            >0</span
                        >
                        <span class="text-body">/</span>
                        <span class="text-body">{totalItems}</span>
                        <span class="text-small text-muted">items checked</span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button class="btn-default btn-sm" id="clear-checked"
                            >Clear Checked</button
                        >
                        <button class="btn-default btn-sm" id="reset-all"
                            >Reset All</button
                        >
                        {
                            recipes.length > 0 && (
                                <button
                                    class="btn-primary btn-sm"
                                    onclick="window.openRecipesModal('recipes-modal')"
                                >
                                    View Recipes ({recipes.length})
                                </button>
                            )
                        }
                    </div>
                </div>
            </div>

            {
                errorMessage && (
                    <div class="alert-error mb-4">
                        <strong>Error:</strong> {errorMessage}
                    </div>
                )
            }

            {
                sortedGroceries.length === 0 &&
                sortedAsNeededGroceries.length === 0 ? (
                    <div class="card">
                        <div class="card-body text-center py-12">
                            <div class="text-6xl mb-4">🛒</div>
                            {recipesParam ? (
                                <p class="text-muted">
                                    No ingredients found in selected recipes
                                </p>
                            ) : (
                                <div>
                                    <p class="text-muted mb-4">
                                        No recipes selected
                                    </p>
                                    <a
                                        href="/recipes/composer"
                                        class="btn-primary"
                                    >
                                        Select Recipes
                                    </a>
                                </div>
                            )}
                        </div>
                    </div>
                ) : (
                    <>
                        <div class="card overflow-hidden">
                            {sortedGroceries.map(([name, quantity]) => (
                                <div class="grocery-item flex items-center px-4 py-3 border-b border-gray-200 dark:border-dark-border last:border-b-0 hover:bg-gray-50 dark:hover:bg-dark-bg transition-colors">
                                    <div class="relative mr-3 flex-shrink-0">
                                        <input
                                            type="checkbox"
                                            class="checkbox grocery-item-checkbox"
                                            id={`item-${name}`}
                                            data-item={name}
                                        />
                                    </div>
                                    <label
                                        for={`item-${name}`}
                                        class="flex-1 flex items-center justify-between gap-4 cursor-pointer"
                                    >
                                        <span class="item-name text-body font-medium">
                                            {name}
                                        </span>
                                        <span class="item-quantity text-small text-muted whitespace-nowrap">
                                            {quantity}
                                        </span>
                                    </label>
                                </div>
                            ))}
                        </div>

                        {sortedAsNeededGroceries.length > 0 && (
                            <>
                                <div class="mt-6 mb-2">
                                    <h3 class="text-small font-semibold text-muted uppercase tracking-wide">
                                        Pantry Staples
                                    </h3>
                                </div>
                                <div class="card overflow-hidden">
                                    {sortedAsNeededGroceries.map(
                                        ([name, quantity]) => (
                                            <div class="grocery-item flex items-center px-4 py-3 border-b border-gray-200 dark:border-dark-border last:border-b-0 hover:bg-gray-50 dark:hover:bg-dark-bg transition-colors">
                                                <div class="relative mr-3 flex-shrink-0">
                                                    <input
                                                        type="checkbox"
                                                        class="checkbox grocery-item-checkbox"
                                                        id={`item-${name}`}
                                                        data-item={name}
                                                    />
                                                </div>
                                                <label
                                                    for={`item-${name}`}
                                                    class="flex-1 flex items-center justify-between gap-4 cursor-pointer"
                                                >
                                                    <span class="item-name text-body font-medium">
                                                        {name}
                                                    </span>
                                                    <span class="item-quantity text-small text-muted whitespace-nowrap">
                                                        {quantity}
                                                    </span>
                                                </label>
                                            </div>
                                        ),
                                    )}
                                </div>
                            </>
                        )}
                    </>
                )
            }
        </div>

        <RecipesModal recipes={recipes} modalId="recipes-modal" />
    </body>
</html>

<script define:vars={{ recipesParam }}>
    // Local storage key - unique per recipe combination
    const STORAGE_KEY = recipesParam
        ? `grocery-list-checked-${recipesParam}`
        : "grocery-list-checked";

    // Load checked items from localStorage
    function loadCheckedItems() {
        try {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored ? new Set(JSON.parse(stored)) : new Set();
        } catch (e) {
            console.error("Failed to load checked items:", e);
            return new Set();
        }
    }

    // Save checked items to localStorage
    function saveCheckedItems(checkedItems) {
        try {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(Array.from(checkedItems)),
            );
        } catch (e) {
            console.error("Failed to save checked items:", e);
        }
    }

    // Update the checked count display
    function updateCheckedCount(count) {
        const countElement = document.getElementById("checked-count");
        if (countElement) {
            countElement.textContent = count.toString();
        }
    }

    // Initialize on page load
    function init() {
        const checkedItems = loadCheckedItems();
        const checkboxes = document.querySelectorAll(".grocery-item-checkbox");

        // Restore checked state
        checkboxes.forEach((checkbox) => {
            const itemName = checkbox.dataset.item;
            if (itemName && checkedItems.has(itemName)) {
                checkbox.checked = true;
                checkbox.closest(".grocery-item")?.classList.add("checked");
            }
        });

        updateCheckedCount(checkedItems.size);

        // Add event listeners to checkboxes
        checkboxes.forEach((checkbox) => {
            checkbox.addEventListener("change", (e) => {
                const target = e.target;
                const itemName = target.dataset.item;
                const item = target.closest(".grocery-item");

                if (!itemName || !item) return;

                if (target.checked) {
                    checkedItems.add(itemName);
                    item.classList.add("checked");
                } else {
                    checkedItems.delete(itemName);
                    item.classList.remove("checked");
                }

                saveCheckedItems(checkedItems);
                updateCheckedCount(checkedItems.size);
            });
        });

        // Clear checked items button
        const clearCheckedBtn = document.getElementById("clear-checked");
        clearCheckedBtn?.addEventListener("click", () => {
            const checkedCheckboxes = document.querySelectorAll(
                ".grocery-item-checkbox:checked",
            );
            checkedCheckboxes.forEach((checkbox) => {
                checkbox.checked = false;
                checkbox.closest(".grocery-item")?.classList.remove("checked");
                const itemName = checkbox.dataset.item;
                if (itemName) {
                    checkedItems.delete(itemName);
                }
            });
            saveCheckedItems(checkedItems);
            updateCheckedCount(0);
        });

        // Reset all button
        const resetAllBtn = document.getElementById("reset-all");
        resetAllBtn?.addEventListener("click", () => {
            checkboxes.forEach((checkbox) => {
                checkbox.checked = false;
                checkbox.closest(".grocery-item")?.classList.remove("checked");
            });
            checkedItems.clear();
            saveCheckedItems(checkedItems);
            updateCheckedCount(0);
        });
    }

    // Run initialization when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>
