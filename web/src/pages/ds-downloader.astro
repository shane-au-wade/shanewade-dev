---
import Head from "@components/head.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
import ThemeToggle from "@components/theme-toggle.astro";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

import romset from "@data/ds-romset-curated.json";

function cleanTitle(filename: string): string {
  let name = filename
    .replace(/\.zip$/, "")
    .replace(/\s*\(USA\).*$/, "")
    .replace(/,\s*The\s+-\s+/, ": The ")
    .replace(/\s+-\s+/g, ": ")
    .trim();
  if (name.endsWith(", The")) {
    name = "The " + name.slice(0, -5);
  }
  return name;
}

const titles = romset.map((item: { href: string; text: string }, i: number) => ({
  id: i,
  href: item.href,
  filename: item.text,
  name: cleanTitle(item.text),
}));
---

<html lang="en">
  <Head title="DS Romset Downloader - Shane Wade" />
  <body
    class="bg-page dark:bg-dark-bg min-h-screen transition-colors duration-300"
  >
    <header
      class="sticky top-0 z-50 bg-white dark:bg-dark-bg-elevated border-b border-gray-200 dark:border-dark-border backdrop-blur-sm bg-opacity-90 dark:bg-opacity-90"
    >
      <div class="container py-2 flex items-center justify-between">
        <Breadcrumbs />
        <ThemeToggle />
      </div>
    </header>

    <div class="container py-8 max-w-3xl">
      <div class="mb-6">
        <h1 class="heading-2 mb-1">DS Romset Downloader</h1>
        <p class="text-muted">
          {titles.length} curated USA titles from the No-Intro decrypted set.
          <span class="badge-warning ml-1">Myrient shuts down March 31, 2026</span>
        </p>
      </div>

      <div class="sticky top-[49px] z-40 bg-white dark:bg-dark-bg-elevated border-b border-gray-200 dark:border-dark-border py-3 -mx-2 px-2 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 mb-4">
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <input
              type="text"
              id="search"
              placeholder="Filter titles..."
              class="input input-sm flex-1"
            />
            <span id="count" class="text-small whitespace-nowrap min-w-[8ch] text-right">
              0 / {titles.length}
            </span>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button id="select-all" class="btn-default btn-sm">Select All</button>
            <button id="select-none" class="btn-default btn-sm">Select None</button>
            <div class="flex-1"></div>
            <button id="download-btn" class="btn-primary btn-sm" disabled>
              <i class="ri-download-line"></i>
              <span id="download-label">Download Selected</span>
            </button>
          </div>

          <div id="progress-container" class="hidden">
            <div class="flex items-center gap-3 mb-1">
              <span id="progress-text" class="text-small">0 / 0</span>
              <button id="cancel-btn" class="btn-error btn-sm">Cancel</button>
            </div>
            <div class="w-full bg-gray-200 dark:bg-dark-bg rounded-full h-2">
              <div
                id="progress-bar"
                class="bg-brand-primary h-2 rounded-full transition-all duration-300"
                style="width: 0%"
              ></div>
            </div>
          </div>
        </div>
      </div>

      <ul id="title-list" class="space-y-1">
        {titles.map((title) => (
          <li
            class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-100 dark:hover:bg-dark-bg-hover transition-colors cursor-pointer"
            data-id={title.id}
            data-href={title.href}
            data-filename={title.filename}
            data-name={title.name.toLowerCase()}
          >
            <input
              type="checkbox"
              class="checkbox shrink-0"
              data-check={title.id}
            />
            <span class="text-small flex-1 select-none">{title.name}</span>
          </li>
        ))}
      </ul>
    </div>

    <script>
      const list = document.getElementById("title-list")!;
      const items = Array.from(list.querySelectorAll("li")) as HTMLLIElement[];
      const searchInput = document.getElementById("search") as HTMLInputElement;
      const countEl = document.getElementById("count")!;
      const selectAllBtn = document.getElementById("select-all")!;
      const selectNoneBtn = document.getElementById("select-none")!;
      const downloadBtn = document.getElementById("download-btn") as HTMLButtonElement;
      const downloadLabel = document.getElementById("download-label")!;
      const progressContainer = document.getElementById("progress-container")!;
      const progressBar = document.getElementById("progress-bar")!;
      const progressText = document.getElementById("progress-text")!;
      const cancelBtn = document.getElementById("cancel-btn")!;

      const total = items.length;
      let cancelled = false;

      function getChecked(): HTMLInputElement[] {
        return items
          .filter((li) => !li.classList.contains("hidden"))
          .map((li) => li.querySelector("input[type=checkbox]") as HTMLInputElement)
          .filter((cb) => cb.checked);
      }

      function getVisible(): HTMLLIElement[] {
        return items.filter((li) => !li.classList.contains("hidden"));
      }

      function updateCount() {
        const selected = getChecked().length;
        countEl.textContent = `${selected} / ${total}`;
        downloadBtn.disabled = selected === 0;
        downloadLabel.textContent = selected > 0
          ? `Download ${selected} Selected`
          : "Download Selected";
      }

      items.forEach((li) => {
        const cb = li.querySelector("input[type=checkbox]") as HTMLInputElement;
        li.addEventListener("click", (e) => {
          if (e.target === cb) return;
          cb.checked = !cb.checked;
          updateCount();
        });
        cb.addEventListener("change", updateCount);
      });

      searchInput.addEventListener("input", () => {
        const query = searchInput.value.toLowerCase().trim();
        items.forEach((li) => {
          const name = li.dataset.name || "";
          li.classList.toggle("hidden", !name.includes(query));
        });
        updateCount();
      });

      selectAllBtn.addEventListener("click", () => {
        getVisible().forEach((li) => {
          (li.querySelector("input[type=checkbox]") as HTMLInputElement).checked = true;
        });
        updateCount();
      });

      selectNoneBtn.addEventListener("click", () => {
        items.forEach((li) => {
          (li.querySelector("input[type=checkbox]") as HTMLInputElement).checked = false;
        });
        updateCount();
      });

      function sleep(ms: number) {
        return new Promise((resolve) => setTimeout(resolve, ms));
      }

      async function downloadFiles() {
        const selected = getChecked().map((cb) => {
          const li = cb.closest("li")!;
          return {
            href: li.dataset.href!,
            filename: li.dataset.filename!,
          };
        });

        if (selected.length === 0) return;

        cancelled = false;
        progressContainer.classList.remove("hidden");
        downloadBtn.disabled = true;
        selectAllBtn.classList.add("hidden");
        selectNoneBtn.classList.add("hidden");

        for (let i = 0; i < selected.length; i++) {
          if (cancelled) break;

          const { href, filename } = selected[i];
          progressText.textContent = `${i + 1} / ${selected.length}: ${filename}`;
          progressBar.style.width = `${((i + 1) / selected.length) * 100}%`;

          const a = document.createElement("a");
          a.href = href;
          a.download = filename;
          a.rel = "noopener noreferrer";
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);

          if (i < selected.length - 1) {
            await sleep(1500);
          }
        }

        if (cancelled) {
          progressText.textContent = "Cancelled";
        } else {
          progressText.textContent = `Done! ${selected.length} files queued for download.`;
          progressBar.style.width = "100%";
        }

        downloadBtn.disabled = false;
        selectAllBtn.classList.remove("hidden");
        selectNoneBtn.classList.remove("hidden");
      }

      downloadBtn.addEventListener("click", downloadFiles);

      cancelBtn.addEventListener("click", () => {
        cancelled = true;
      });

      updateCount();
    </script>
  </body>
</html>
