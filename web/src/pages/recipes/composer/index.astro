---
import "remixicon/fonts/remixicon.css";
import "@styles/components.css";

import Breadcrumbs from "@components/breadcrumbs.astro";
import Head from "@components/head.astro";

// fetch a simple list of recipes and display them in a grid
import { supabase } from "../../../lib/db/supabase-client";

const { data: recipes, error } = await supabase
    .from("recipes")
    .select(
        "id, title, subtitle, company_name, servings, cook_time_minutes, created_at",
    )
    .order("created_at", { ascending: false });

if (error) {
    console.error(error);
    return new Response("Error fetching recipes: " + error.message, {
        status: 500,
        statusText: "Internal Server Error: " + error.message,
    });
}

const UI_COMPONENT_IDS = {
    searchInput: "search-input",
    companyFilter: "company-filter",
    servingsFilter: "servings-filter",
    timeFilter: "time-filter",
    recipeGrid: "recipe-grid",
    selectionInfo: "selection-info",
    clearSelection: "clear-selection",
    viewIds: "view-ids",
    copyBtn: "copy-btn",
    clearAllBtn: "clear-all-btn",
    generateListBtn: "generate-list-btn",
    selectedIdsSection: "selected-ids-section",
    selectedIdsList: "selected-ids-list",
    selectedPanel: "selected-panel",
    selectedList: "selected-list",
    selectedCount: "selected-count",
    emptySelectionMessage: "empty-selection-message",
    emptySelectionMessageIcon: "empty-selection-message-icon",
    emptySelectionMessageText: "empty-selection-message-text",
    selectedRecipeItem: "selected-recipe-item",
    selectedRecipeRemove: "selected-recipe-remove",
    selectedRecipeItemHeader: "selected-recipe-item-header",
    selectedRecipeCompany: "selected-recipe-company",
    selectedRecipeTitle: "selected-recipe-title",
    selectedRecipeSubtitle: "selected-recipe-subtitle",
    selectedRecipeMeta: "selected-recipe-meta",
};
---

<style>
    /* Selected recipe card state */
    .recipe-card.selected {
        border-color: var(--color-brand-primary) !important;
        background-color: rgba(196, 69, 54, 0.05) !important;
    }

    .recipe-card.selected::before {
        content: "✓";
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 28px;
        height: 28px;
        background: var(--color-brand-primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1rem;
        z-index: 10;
    }
</style>

<html lang="en">
    <Head title="Recipe Composer - Shane Wade" />
    <body class="bg-page dark:bg-dark-bg min-h-screen">
        <button
            id="scroll-to-bottom-fab"
            type="button"
            class="btn-primary fixed z-50 bottom-1 right-1"
            aria-label="Scroll to bottom"
        >
            <i class="ri-arrow-down-s-line"></i>
        </button>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const fab = document.getElementById("scroll-to-bottom-fab");
                if (fab) {
                    fab.addEventListener("click", () => {
                        window.scrollTo({
                            top: document.body.scrollHeight,
                            behavior: "smooth",
                        });
                    });
                }

                // Intersection observer to hide the FAB when the user is at the bottom of the page
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!fab) return;
                            if (entry.isIntersecting) {
                                fab.style.display = "none";
                            } else {
                                fab.style.display = "block";
                            }
                        });
                    },
                    {
                        threshold: 0.5,
                    },
                );

                const bottomSpacer = document.querySelector("#bottom-spacer");
                if (bottomSpacer) {
                    observer.observe(bottomSpacer);
                }
            });
        </script>

        <div class="container mx-auto py-6 flex flex-col lg:flex-row gap-6">
            <div class="flex-1 min-w-0">
                <!-- Search & Filters Card -->
                <div class="card mb-6">
                    <div class="card-header">
                        <Breadcrumbs />
                        <br />
                        <h1 class="heading-3 mb-2">Recipe Composer</h1>
                        <p class="text-muted">
                            Select recipes to create a grocery list or meal plan
                        </p>
                    </div>
                    <div class="card-body space-y-4">
                        <div class="flex flex-wrap gap-4">
                            <div class="flex-1 min-w-[200px]">
                                <label class="label mb-2">Company:</label>
                                <select
                                    id={UI_COMPONENT_IDS.companyFilter}
                                    class="select w-full"
                                >
                                    <option value="">All Companies</option>
                                </select>
                            </div>

                            <div class="flex-1 min-w-[200px]">
                                <label class="label mb-2">Servings:</label>
                                <select
                                    id={UI_COMPONENT_IDS.servingsFilter}
                                    class="select w-full"
                                >
                                    <option value="">All Servings</option>
                                </select>
                            </div>

                            <div class="flex-1 min-w-[200px]">
                                <label class="label mb-2">Cook Time:</label>
                                <select
                                    id={UI_COMPONENT_IDS.timeFilter}
                                    class="select w-full"
                                >
                                    <option value="">Any Time</option>
                                    <option value="0-20">Under 20 min</option>
                                    <option value="20-30">20-30 min</option>
                                    <option value="30-45">30-45 min</option>
                                    <option value="45-999">45+ min</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <div class="relative flex items-center">
                                <span class="absolute left-3 text-gray-400">
                                    <i class="ri-search-line"></i>
                                </span>
                                <input
                                    type="text"
                                    autocomplete="off"
                                    id={UI_COMPONENT_IDS.searchInput}
                                    class="input w-full pl-10"
                                    placeholder="Search recipes by title, subtitle, or company"
                                />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recipe Grid -->
                <ul
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
                    id={UI_COMPONENT_IDS.recipeGrid}
                >
                    {
                        recipes.map((recipe) => (
                            <li
                                class="recipe-card card-hover relative"
                                data-recipe-id={recipe.id}
                                data-company={recipe.company_name || ""}
                                data-servings={recipe.servings || 0}
                                data-cook-time={recipe.cook_time_minutes || 0}
                            >
                                <div class="card-body">
                                    <div class="recipe-company badge-secondary text-xs mb-3 inline-block uppercase tracking-wide">
                                        {recipe.company_name || "Unknown"}
                                    </div>
                                    <h3 class="recipe-title heading-5 mb-2">
                                        {recipe.title}
                                    </h3>
                                    <p class="recipe-subtitle text-small text-muted mb-4 line-clamp-2">
                                        {recipe.subtitle || "No description"}
                                    </p>
                                    <div class="recipe-meta flex gap-3 text-sm text-gray-600 dark:text-dark-text-secondary">
                                        <div class="flex items-center gap-1">
                                            <span>🍽️</span>
                                            <span>
                                                {recipe.servings
                                                    ? `${recipe.servings} servings`
                                                    : "N/A"}
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <span>⏱️</span>
                                            <span>
                                                {recipe.cook_time_minutes
                                                    ? `${recipe.cook_time_minutes} min`
                                                    : "N/A"}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Selected Recipes Panel -->
            <aside
                class="card w-full lg:max-w-[380px] lg:sticky lg:top-6 flex flex-col lg:max-h-[calc(100vh-3rem)]"
                id={UI_COMPONENT_IDS.selectedPanel}
            >
                <div class="card-header">
                    <h3 class="heading-4 mb-1">Selected Recipes</h3>
                    <p
                        class="text-small text-muted"
                        id={UI_COMPONENT_IDS.selectedCount}
                    >
                        No recipes selected
                    </p>
                </div>
                <div
                    class="flex-1 overflow-y-auto px-6 py-4"
                    id={UI_COMPONENT_IDS.selectedList}
                >
                    <div
                        class="text-center py-12 text-gray-500 dark:text-dark-text-muted"
                    >
                        <div class="text-5xl mb-4 opacity-50">🍽️</div>
                        <div class="text-sm">Select recipes to get started</div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="flex flex-col gap-2 w-full">
                        <button
                            class="btn-primary w-full"
                            id={UI_COMPONENT_IDS.generateListBtn}
                            disabled
                        >
                            Generate Grocery List
                        </button>
                        <button
                            class="btn-default w-full"
                            id={UI_COMPONENT_IDS.clearAllBtn}
                        >
                            Clear All
                        </button>
                    </div>
                </div>
            </aside>
        </div>
        <div class="h-0 outline" id="bottom-spacer"></div>
    </body>

    <!-- Hidden template for UnoCSS class detection (dynamically generated content) -->
    <template id="unocss-safelist" style="display: none;">
        <!-- Empty state -->
        <div class="text-center py-12 text-gray-500 dark:text-dark-text-muted">
            <div class="text-5xl mb-4 opacity-50"></div>
            <div class="text-sm"></div>
        </div>
        <!-- Selected recipe item -->
        <div
            class="bg-gray-50 dark:bg-dark-bg-elevated border border-gray-200 dark:border-dark-border rounded-lg p-3 mb-3 relative transition-all hover:bg-white dark:hover:bg-dark-bg-hover hover:shadow-sm"
        >
            <button
                class="selected-recipe-remove absolute top-3 right-3 w-6 h-6 flex items-center justify-center bg-error hover:bg-error-dark text-white rounded-full text-lg font-bold transition-all hover:scale-110 cursor-pointer border-none p-0"
            ></button>
            <div class="pr-8">
                <div class="badge-secondary text-xs mb-2 inline-block"></div>
                <h4 class="heading-6 mb-1"></h4>
                <p
                    class="text-xs text-gray-600 dark:text-dark-text-secondary mb-3 line-clamp-2"
                >
                </p>
                <div class="flex gap-2 flex-wrap">
                    <span class="badge-secondary text-xs"></span>
                    <span class="badge-info text-xs"></span>
                </div>
            </div>
        </div>
        <!-- No results message -->
        <div
            class="no-results text-center col-span-full py-12 text-gray-500 dark:text-dark-text-muted text-lg"
        >
        </div>
    </template>
</html>

<script define:vars={{ UI_COMPONENT_IDS }}>
    const DOM_ELEMENTS = {
        searchInput: null,
        companyFilter: null,
        servingsFilter: null,
        timeFilter: null,
        selectionInfo: null,
        clearSelection: null,
        viewIds: null,
        copyBtn: null,
        clearAllBtn: null,
        generateListBtn: null,
        selectedIdsSection: null,
        selectedIdsList: null,
        selectedPanel: null,
        selectedList: null,
        selectedCount: null,
        emptySelectionMessage: null,
        emptySelectionMessageIcon: null,
        emptySelectionMessageText: null,
        selectedRecipeItem: null,
        selectedRecipeRemove: null,
        selectedRecipeItemHeader: null,
        selectedRecipeCompany: null,
        selectedRecipeTitle: null,
        selectedRecipeSubtitle: null,
        selectedRecipeMeta: null,
    };

    // @ts-nocheck
    // State management with observer pattern
    const state = {
        selectedRecipes: new Set(),
        selectedRecipesData: new Map(), // Store full recipe data
        allRecipes: [],
        listeners: new Set(),

        // Observer pattern methods
        subscribe(listener) {
            this.listeners.add(listener);
        },

        notify() {
            this.listeners.forEach((fn) => fn(this));
        },

        // State mutation methods that auto-notify
        selectRecipe(id, recipe) {
            this.selectedRecipes.add(id);
            if (recipe) {
                this.selectedRecipesData.set(id, recipe);
            }
            this.notify();
        },

        deselectRecipe(id) {
            this.selectedRecipes.delete(id);
            this.selectedRecipesData.delete(id);
            this.notify();
        },

        clearAllSelections() {
            this.selectedRecipes.clear();
            this.selectedRecipesData.clear();
            this.notify();
        },
    };

    // Initialize
    document.addEventListener("DOMContentLoaded", () => {
        initializeDOMElements();
        initializeRecipes();
        setupStateObservers();
        setupEventListeners();
        populateFilters();
    });

    // Set up state observers - UI updates automatically when state changes
    function setupStateObservers() {
        state.subscribe(() => {
            updateSelectedPanel();
        });
    }

    function initializeDOMElements() {
        DOM_ELEMENTS.searchInput = document.getElementById(
            UI_COMPONENT_IDS.searchInput,
        );
        DOM_ELEMENTS.companyFilter = document.getElementById(
            UI_COMPONENT_IDS.companyFilter,
        );
        DOM_ELEMENTS.servingsFilter = document.getElementById(
            UI_COMPONENT_IDS.servingsFilter,
        );
        DOM_ELEMENTS.timeFilter = document.getElementById(
            UI_COMPONENT_IDS.timeFilter,
        );
        DOM_ELEMENTS.selectionInfo = document.getElementById(
            UI_COMPONENT_IDS.selectionInfo,
        );
        DOM_ELEMENTS.clearSelection = document.getElementById(
            UI_COMPONENT_IDS.clearSelection,
        );
        DOM_ELEMENTS.viewIds = document.getElementById(
            UI_COMPONENT_IDS.viewIds,
        );
        DOM_ELEMENTS.copyBtn = document.getElementById(
            UI_COMPONENT_IDS.copyBtn,
        );
        DOM_ELEMENTS.clearAllBtn = document.getElementById(
            UI_COMPONENT_IDS.clearAllBtn,
        );
        DOM_ELEMENTS.generateListBtn = document.getElementById(
            UI_COMPONENT_IDS.generateListBtn,
        );
        DOM_ELEMENTS.selectedIdsSection = document.getElementById(
            UI_COMPONENT_IDS.selectedIdsSection,
        );
        DOM_ELEMENTS.selectedIdsList = document.getElementById(
            UI_COMPONENT_IDS.selectedIdsList,
        );
        DOM_ELEMENTS.selectedPanel = document.getElementById(
            UI_COMPONENT_IDS.selectedPanel,
        );
        DOM_ELEMENTS.selectedList = document.getElementById(
            UI_COMPONENT_IDS.selectedList,
        );
        DOM_ELEMENTS.selectedCount = document.getElementById(
            UI_COMPONENT_IDS.selectedCount,
        );
        DOM_ELEMENTS.emptySelectionMessage = document.getElementById(
            UI_COMPONENT_IDS.emptySelectionMessage,
        );
        DOM_ELEMENTS.emptySelectionMessageIcon = document.getElementById(
            UI_COMPONENT_IDS.emptySelectionMessageIcon,
        );
        DOM_ELEMENTS.emptySelectionMessageText = document.getElementById(
            UI_COMPONENT_IDS.emptySelectionMessageText,
        );
        DOM_ELEMENTS.selectedRecipeItem = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeItem,
        );
        DOM_ELEMENTS.selectedRecipeRemove = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeRemove,
        );
        DOM_ELEMENTS.selectedRecipeItemHeader = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeItemHeader,
        );
        DOM_ELEMENTS.selectedRecipeCompany = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeCompany,
        );
        DOM_ELEMENTS.selectedRecipeTitle = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeTitle,
        );
        DOM_ELEMENTS.selectedRecipeSubtitle = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeSubtitle,
        );
        DOM_ELEMENTS.selectedRecipeMeta = document.getElementById(
            UI_COMPONENT_IDS.selectedRecipeMeta,
        );
    }

    function initializeRecipes() {
        const cards = document.querySelectorAll(".recipe-card");
        cards.forEach((card) => {
            const titleEl = card.querySelector(".recipe-title");
            const subtitleEl = card.querySelector(".recipe-subtitle");

            if (!titleEl || !subtitleEl) return;

            state.allRecipes.push({
                id: card.dataset.recipeId || "",
                title: titleEl.textContent || "",
                subtitle: subtitleEl.textContent || "",
                company: card.dataset.company || "",
                servings: parseInt(card.dataset.servings || "0"),
                cookTime: parseInt(card.dataset.cookTime || "0"),
                element: card,
            });
        });
    }

    function setupEventListeners() {
        // Recipe card selection
        document.querySelectorAll(".recipe-card").forEach((card) => {
            card.addEventListener("click", () => {
                const recipeId = card.dataset.recipeId;
                if (recipeId) {
                    toggleRecipeSelection(recipeId, card);
                }
            });
        });

        // Event delegation for remove buttons in selected panel
        const selectedList = DOM_ELEMENTS.selectedList;
        if (selectedList) {
            selectedList.addEventListener("click", (e) => {
                const removeBtn = e.target.closest(".selected-recipe-remove");
                if (removeBtn) {
                    const recipeId = removeBtn.dataset.recipeId;
                    if (recipeId) {
                        removeRecipeFromSelection(recipeId);
                    }
                }
            });
        }

        // Search
        const searchInput = DOM_ELEMENTS.searchInput;
        if (searchInput) {
            searchInput.addEventListener("input", () => {
                filterRecipes();
            });
        }

        // Filters
        const companyFilter = DOM_ELEMENTS.companyFilter;
        const servingsFilter = DOM_ELEMENTS.servingsFilter;
        const timeFilter = DOM_ELEMENTS.timeFilter;

        if (companyFilter)
            companyFilter.addEventListener("change", filterRecipes);
        if (servingsFilter)
            servingsFilter.addEventListener("change", filterRecipes);
        if (timeFilter) timeFilter.addEventListener("change", filterRecipes);

        // Selection actions
        const clearBtn = DOM_ELEMENTS.clearSelection;
        const viewBtn = DOM_ELEMENTS.viewIds;
        const copyBtn = DOM_ELEMENTS.copyBtn;
        const clearAllBtn = DOM_ELEMENTS.clearAllBtn;
        const generateBtn = DOM_ELEMENTS.generateListBtn;

        if (clearBtn) clearBtn.addEventListener("click", clearSelection);
        if (viewBtn) viewBtn.addEventListener("click", viewSelectedIds);
        if (copyBtn) copyBtn.addEventListener("click", copyToClipboard);
        if (clearAllBtn) clearAllBtn.addEventListener("click", clearSelection);
        if (generateBtn)
            generateBtn.addEventListener("click", generateGroceryList);
    }

    function populateFilters() {
        // Get unique companies
        const companies = [
            ...new Set(state.allRecipes.map((r) => r.company).filter((c) => c)),
        ].sort();
        const companyFilter = DOM_ELEMENTS.companyFilter;
        if (companyFilter) {
            companies.forEach((company) => {
                const option = document.createElement("option");
                option.value = company;
                option.textContent = company;
                companyFilter.appendChild(option);
            });
        }

        // Get unique servings
        const servings = [...new Set(state.allRecipes.map((r) => r.servings))]
            .filter((s) => s > 0)
            .sort((a, b) => a - b);
        const servingsFilter = DOM_ELEMENTS.servingsFilter;
        if (servingsFilter) {
            servings.forEach((serving) => {
                const option = document.createElement("option");
                option.value = serving.toString();
                option.textContent = `${serving} servings`;
                servingsFilter.appendChild(option);
            });
        }
    }

    function toggleRecipeSelection(recipeId, card) {
        const recipe = state.allRecipes.find((r) => r.id === recipeId);

        if (state.selectedRecipes.has(recipeId)) {
            state.deselectRecipe(recipeId);
            card.classList.remove("selected");
        } else {
            state.selectRecipe(recipeId, recipe);
            card.classList.add("selected");
        }
        // UI updates happen automatically via observer pattern!
    }

    function removeRecipeFromSelection(recipeId) {
        state.deselectRecipe(recipeId);

        // Update the card visual
        const card = document.querySelector(`[data-recipe-id="${recipeId}"]`);
        if (card) {
            card.classList.remove("selected");
        }
        // UI updates happen automatically via observer pattern!
    }

    function clearSelection() {
        state.clearAllSelections();
        document.querySelectorAll(".recipe-card.selected").forEach((card) => {
            card.classList.remove("selected");
        });
        hideSelectedIds();
        // UI updates happen automatically via observer pattern!
    }

    function updateSelectedPanel() {
        const panel = DOM_ELEMENTS.selectedPanel;
        const list = DOM_ELEMENTS.selectedList;
        const count = DOM_ELEMENTS.selectedCount;
        const generateBtn = DOM_ELEMENTS.generateListBtn;

        if (!panel || !list || !count) return;

        const selectedCount = state.selectedRecipes.size;

        // Update count text
        if (selectedCount === 0) {
            count.textContent = "No recipes selected";
            panel.classList.add("hidden");
            if (generateBtn) generateBtn.disabled = true;
        } else {
            count.textContent = `${selectedCount} recipe${selectedCount !== 1 ? "s" : ""} selected`;
            panel.classList.remove("hidden");
            if (generateBtn) generateBtn.disabled = false;
        }

        // Update list content
        if (selectedCount === 0) {
            list.innerHTML = `
                <div class="text-center py-12 text-gray-500 dark:text-dark-text-muted">
                    <div class="text-5xl mb-4 opacity-50">🍽️</div>
                    <div class="text-sm">
                        Select recipes to get started
                    </div>
                </div>
            `;
        } else {
            const recipesArray = Array.from(state.selectedRecipesData.values());
            list.innerHTML = recipesArray
                .map(
                    (recipe) => `
                <div class="bg-gray-50 dark:bg-dark-bg-elevated border border-gray-200 dark:border-dark-border rounded-lg p-3 mb-3 relative transition-all hover:bg-white dark:hover:bg-dark-bg-hover hover:shadow-sm">
                    <button 
                        class="selected-recipe-remove absolute top-3 right-3 w-6 h-6 flex items-center justify-center bg-error hover:bg-error-dark text-white rounded-full text-lg font-bold transition-all hover:scale-110 cursor-pointer border-none p-0" 
                        data-recipe-id="${recipe.id}"
                        title="Remove recipe"
                    >
                        ×
                    </button>
                    <div class="pr-8">
                        <div class="badge-secondary text-xs mb-2 inline-block">${recipe.company || "UNKNOWN"}</div>
                        <h4 class="heading-6 mb-1">${recipe.title}</h4>
                        <p class="text-xs text-gray-600 dark:text-dark-text-secondary mb-3 line-clamp-2">${recipe.subtitle || ""}</p>
                        <div class="flex gap-2 flex-wrap">
                            <span class="badge-secondary text-xs">🍽️ ${recipe.servings || "N/A"} servings</span>
                            <span class="badge-info text-xs">⏱️ ${recipe.cookTime || "N/A"} min</span>
                        </div>
                    </div>
                </div>
            `,
                )
                .join("");
        }
    }

    function generateGroceryList() {
        if (state.selectedRecipes.size === 0) {
            alert("Please select at least one recipe");
            return;
        }

        // Navigate to groceries page with recipe IDs in URL
        const ids = Array.from(state.selectedRecipes);
        const recipeParams = ids.join(",");
        window.location.href = `/groceries?recipes=${encodeURIComponent(recipeParams)}`;
    }

    function viewSelectedIds() {
        const section = DOM_ELEMENTS.selectedIdsSection;
        const list = DOM_ELEMENTS.selectedIdsList;

        if (state.selectedRecipes.size === 0) {
            return;
        }

        const ids = Array.from(state.selectedRecipes);
        if (list) {
            list.textContent = JSON.stringify(ids, null, 2);
        }
        if (section) {
            section.style.display = "block";
            section.scrollIntoView({
                behavior: "smooth",
                block: "nearest",
            });
        }
    }

    function hideSelectedIds() {
        const section = DOM_ELEMENTS.selectedIdsSection;
        if (section) {
            section.style.display = "none";
        }
    }

    function copyToClipboard() {
        const ids = Array.from(state.selectedRecipes);
        const text = JSON.stringify(ids);
        navigator.clipboard.writeText(text).then(() => {
            const btn = DOM_ELEMENTS.copyBtn;
            if (btn) {
                const originalText = btn.textContent;
                btn.textContent = "Copied!";
                btn.classList.add("copied");
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.classList.remove("copied");
                }, 2000);
            }
        });
    }

    function filterRecipes() {
        const searchInput = DOM_ELEMENTS.searchInput;
        const companyFilter = DOM_ELEMENTS.companyFilter;
        const servingsFilter = DOM_ELEMENTS.servingsFilter;
        const timeFilter = DOM_ELEMENTS.timeFilter;

        if (!searchInput || !companyFilter || !servingsFilter || !timeFilter) {
            return;
        }

        const searchTerm = searchInput.value.toLowerCase();
        const companyValue = companyFilter.value;
        const servingsValue = servingsFilter.value;
        const timeValue = timeFilter.value;

        let visibleCount = 0;

        state.allRecipes.forEach((recipe) => {
            let visible = true;

            // Search filter
            if (searchTerm) {
                const searchableText =
                    `${recipe.title} ${recipe.subtitle} ${recipe.company}`.toLowerCase();
                visible = visible && searchableText.includes(searchTerm);
            }

            // Company filter
            if (companyValue) {
                visible = visible && recipe.company === companyValue;
            }

            // Servings filter
            if (servingsValue) {
                visible =
                    visible && recipe.servings === parseInt(servingsValue);
            }

            // Time filter
            if (timeValue) {
                const [min, max] = timeValue.split("-").map(Number);
                visible =
                    visible && recipe.cookTime >= min && recipe.cookTime <= max;
            }

            if (recipe.element) {
                recipe.element.style.display = visible ? "block" : "none";
            }
            if (visible) visibleCount++;
        });

        // Show no results message if needed
        const grid = DOM_ELEMENTS.recipeGrid;
        if (!grid) return;

        let noResults = grid.querySelector(".no-results");

        if (visibleCount === 0) {
            if (!noResults) {
                noResults = document.createElement("li");
                noResults.className =
                    "no-results text-center col-span-full py-12 text-gray-500 dark:text-dark-text-muted text-lg";
                noResults.textContent =
                    "No recipes found matching your criteria";
                grid.appendChild(noResults);
            }
        } else if (noResults) {
            noResults.remove();
        }
    }
</script>
