---
export const prerender = false;
import Head from "@components/head.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
import ThemeToggle from "@components/theme-toggle.astro";

import { getRecipe } from "@shared/recipes/queries";
import { supabase } from "../../../lib/db/supabase-client";

const { id } = Astro.params;

if (!id) {
    return new Response("Recipe ID is required", {
        status: 400,
        statusText: "Bad Request",
    });
}

let recipe;
try {
    recipe = await getRecipe(supabase, id);
} catch (error) {
    console.error("Error fetching recipe:", error);
    return new Response("Error fetching recipe", {
        status: 500,
        statusText: "Internal Server Error",
    });
}

if (!recipe) {
    return new Response("Recipe not found", {
        status: 404,
        statusText: "Not Found",
    });
}
---

<html lang="en">
    <Head title={`Debug: ${recipe.title}`} />
    <body class="bg-page dark:bg-dark-bg min-h-screen">
        <!-- Header -->
        <header
            class="sticky top-0 z-50 bg-white dark:bg-dark-bg-elevated border-b border-gray-200 dark:border-dark-border backdrop-blur-sm bg-opacity-90 dark:bg-opacity-90"
        >
            <div class="container py-4 flex items-center justify-between">
                <div>
                    <Breadcrumbs />
                    <h1 class="heading-3">OCR Debug: {recipe.title}</h1>
                    <p class="text-muted">Raw OCR markdown output</p>
                </div>
                <ThemeToggle />
            </div>
        </header>

        <!-- Main Content -->
        <div class="container py-8">
            <div class="mb-6 flex gap-3">
                <a href={`/recipes/${id}`} class="btn-outline">
                    ← Back to Recipe
                </a>
                <a href="/recipes" class="btn-default"> All Recipes </a>
            </div>

            <!-- Recipe Info Card -->
            <div class="card mb-6">
                <div class="card-header">
                    <h2 class="heading-5">Recipe Information</h2>
                </div>
                <div class="card-body">
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 text-body"
                    >
                        <div>
                            <span class="text-muted">Recipe ID:</span>
                            <code
                                class="ml-2 text-small bg-gray-100 dark:bg-dark-bg px-2 py-1 rounded"
                                >{id}</code
                            >
                        </div>
                        <div>
                            <span class="text-muted">Title:</span>
                            <span class="ml-2">{recipe.title}</span>
                        </div>
                        {
                            recipe.company_name && (
                                <div>
                                    <span class="text-muted">Company:</span>
                                    <span class="ml-2">
                                        {recipe.company_name}
                                    </span>
                                </div>
                            )
                        }
                        {
                            recipe.pages && recipe.pages.length > 0 && (
                                <div>
                                    <span class="text-muted">Pages:</span>
                                    <span class="ml-2">
                                        {recipe.pages.length} page(s)
                                    </span>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- OCR Markdown Display -->
            <div class="card">
                <div class="card-header">
                    <h2 class="heading-5">OCR Markdown</h2>
                </div>
                <div class="card-body">
                    {
                        recipe.ocr_markdown ? (
                            <pre class="bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border rounded-lg p-6 overflow-x-auto text-sm leading-relaxed whitespace-pre-wrap break-words font-mono text-gray-800 dark:text-dark-text">
                                {recipe.ocr_markdown}
                            </pre>
                        ) : (
                            <div class="alert-warning">
                                <strong>No OCR markdown available</strong>
                                <p class="text-small mt-2">
                                    This recipe doesn't have OCR markdown data
                                    stored.
                                </p>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </body>
</html>
