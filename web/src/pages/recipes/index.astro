---
// fetch a simple list of recipes and display them in a grid
import { supabase } from "../../lib/db/supabase-client";

const { data: recipes, error } = await supabase
    .from("recipes")
    .select(
        "id, title, subtitle, company_name, servings, cook_time, created_at",
    );

if (error) {
    console.error(error);
    return new Response("Error fetching recipes", {
        status: 500,
        statusText: "Internal Server Error",
    });
}
---

<style>
    li {
        list-style: none;
    }

    .recipe-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .recipe-card {
        border: 1px solid #ccc;
        padding: 1rem;
        border-radius: 0.5rem;
    }

    .recipe-card h2 {
        font-size: 1.5rem;
        margin: 0;
    }

    .recipe-card p {
        margin: 0;
        font-size: 1rem;
        color: #666;
    }

    .recipe-card a {
        text-decoration: none;
        color: #000;
    }

    .recipe-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
    }

    .recipe-card a:visited {
        color: #666;
    }

    .recipe-card-link {
        text-decoration: none;
        color: #000;
    }
</style>

<html>
    <head>
        <title>Recipes</title>
    </head>
    <body>
        <h1>Recipes</h1>
        <ul class="recipe-grid">
            {
                recipes.map((recipe) => (
                    <a href={`/recipes/${recipe.id}`} class="recipe-card-link">
                        <li class="recipe-card">
                            <p>{recipe.company_name}</p>

                            <h2>{recipe.title}</h2>

                            <p>{recipe.subtitle}</p>
                            <br />
                            <p>{recipe.servings}</p>
                            <p>{recipe.cook_time}</p>
                        </li>
                    </a>
                ))
            }
        </ul>
    </body>
</html>
