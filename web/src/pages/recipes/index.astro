---
// fetch a simple list of recipes and display them in a grid
import { supabase } from "../../lib/db/supabase-client";

const { data: recipes, error } = await supabase
    .from("recipes")
    .select(
        "id, title, subtitle, company_name, servings, cook_time_minutes, created_at",
    );

if (error) {
    console.error(error);
    return new Response("Error fetching recipes: " + error.message, {
        status: 500,
        statusText: "Internal Server Error: " + error.message,
    });
}
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Recipes - Shane Wade</title>
    </head>
    <body class="bg-page dark:bg-dark-bg min-h-screen">
        <!-- Header Section -->
        <header
            class="border-b border-gray-200 dark:border-dark-border bg-white dark:bg-dark-bg-elevated"
        >
            <div class="container py-6">
                <nav class="mb-4">
                    <a href="/" class="link-subtle text-sm">← Back to Home</a>
                </nav>
                <h1 class="heading-1 mb-2">Recipes</h1>
                <p
                    class="text-lead text-gray-600 dark:text-dark-text-secondary"
                >
                    Browse our collection of delicious recipes
                </p>
            </div>
        </header>

        <!-- Main Content -->
        <main class="container py-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    recipes.map((recipe) => (
                        <a
                            href={`/recipes/${recipe.id}`}
                            class="card-hover block no-underline"
                        >
                            <div class="card-body">
                                <p class="text-muted mb-2">
                                    {recipe.company_name}
                                </p>
                                <h2 class="heading-5 mb-2">{recipe.title}</h2>
                                <p class="text-body text-gray-600 dark:text-dark-text-secondary mb-4">
                                    {recipe.subtitle}
                                </p>
                                <div class="flex gap-2 flex-wrap">
                                    <span class="badge-secondary">
                                        {recipe.servings} servings
                                    </span>
                                    <span class="badge-info">
                                        {recipe.cook_time_minutes} min
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>
        </main>
    </body>
</html>
