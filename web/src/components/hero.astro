---
import "@styles/colors.css";
import "@styles/components.css";
import Image from "astro/components/Image.astro";
import hero_photo from "../images/profile_pic.jpeg";
---

<style>
    .image-wrapper {
        width: fit-content;
        position: relative;
    }

    .image-wrapper::before {
        content: "";
        position: absolute;
        top: -20px;
        right: -20px;
        width: 150px;
        height: 150px;
        background-color: var(--color-brand-primary);
        z-index: -1;
    }

    .image-wrapper::after {
        content: "";
        position: absolute;
        bottom: -20px;
        left: -20px;
        width: 100px;
        height: 100px;
        background-color: var(--color-brand-primary-dark);
        z-index: -1;
    }

    .hero-section-image {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
    }

    .hero-section-image img {
        border-radius: 7px;
    }

    #hero-section {
        max-width: 1400px;
        margin: auto;
        flex-direction: row-reverse;
        @media (orientation: portrait) {
            flex-direction: column;
        }
    }
</style>

<section id="hero-section" class="full-page-section flex flex-col">
    <div class="hero-section-image">
        <div class="image-wrapper">
            <Image alt="Picture of Shane Wade with a bike" src={hero_photo} />
        </div>
    </div>
    <div class="flex-1 p-2 flex justify-center">
        <div
            class="flex flex-col gap-5 bg-transparent backdrop-blur-md p-6 rounded-lg border border-gray-200 dark:border-dark-border"
            style={{
                margin: "auto",
            }}
        >
            <p class="heading-4 text-gray-600 dark:text-dark-text-secondary">
                Hello 👋
            </p>
            <div>
                <span
                    class="uppercase heading-5 tracking-widest text-gray-500 dark:text-dark-text-muted block mb-2"
                >
                    Software Engineer & Cyclist
                </span>
                <h1 class="heading-1 m-0">Shane Wade</h1>
            </div>
            <p class="text-lead">
                I'm a software engineer and AI mechanic 🔧 🤖<br />
                I love bicycles and building products.
            </p>
            <div class="flex gap-4 mt-2 md:flex-col">
                <button class="btn-primary">View My Work</button>
                <button class="btn-outline">Get In Touch</button>
            </div>
        </div>
    </div>
</section>
