---
import "@styles/colors.css";
import "@styles/components.css";

import Image from "astro/components/Image.astro";
import hero_photo from "../../public/profile_pic.jpeg";
---

<style>
    .image-wrapper::before {
        content: "";
        position: absolute;
        top: -20px;
        right: -20px;
        width: 150px;
        height: 150px;
        background-color: var(--color-brand-primary);
        z-index: -1;
    }

    .image-wrapper::after {
        content: "";
        position: absolute;
        bottom: -20px;
        left: -20px;
        width: 100px;
        height: 100px;
        background-color: var(--color-brand-primary-dark);
        z-index: -1;
    }

    #hero-section {
        max-width: 1400px;
        margin: auto;
        @media screen and (orientation: landscape) {
            flex-direction: row-reverse;
        }
    }
</style>

<section id="hero-section" class="full-page-section flex flex-col">
    <div class="flex-1 flex items-center justify-center p-8 relative">
        <div class="max-w-[500px] w-full relative image-wrapper">
            <Image
                alt="Picture of Shane Wade with a bike"
                src={hero_photo}
                class="w-full h-auto block rounded-lg"
            />
        </div>
    </div>
    <div class="flex-1 p-8 flex justify-center">
        <div
            class="flex flex-col gap-6 bg-transparent backdrop-blur-md p-8 rounded-lg border border-gray-200 dark:border-dark-border"
            style={{
                margin: "auto",
            }}
        >
            <p
                class="text-2xl font-medium text-gray-600 dark:text-dark-text-secondary m-0"
            >
                Hello 👋
            </p>
            <div>
                <span
                    class="uppercase tracking-widest text-sm text-gray-500 dark:text-dark-text-muted font-medium block mb-2"
                >
                    Software Engineer & Cyclist
                </span>
                <h1 class="heading-1 text-6xl md:text-4xl sm:text-3xl m-0">
                    Shane Wade
                </h1>
            </div>
            <p class="text-lead m-0">
                I'm a software engineer and AI mechanic 🔧 🤖<br />
                I love bicycles and building products.
            </p>
            <div class="flex gap-4 mt-2 md:flex-col">
                <button class="btn-primary">View My Work</button>
                <button class="btn-outline">Get In Touch</button>
            </div>
        </div>
    </div>
</section>
