---
import "@styles/colors.css";
import "@styles/components.css";

import { Picture } from "astro:assets";
import hero_photo from "../images/sw-headshot-2025.png";
import { maxHeight } from "@components/navigation.astro";
---

<style define:vars={{ maxHeight }}>
    .image-wrapper {
        margin-top: var(--maxHeight);
        padding: 1rem;
        max-width: 350px;
        width: fit-content;
        position: relative;
    }

    .image-wrapper::before {
        content: "";
        position: absolute;
        top: -20px;
        right: -20px;
        width: 150px;
        height: 150px;
        background-color: var(--color-brand-primary-dark);
        z-index: -1;
    }

    .image-wrapper::after {
        content: "";
        position: absolute;
        bottom: -20px;
        left: -20px;
        width: 100px;
        height: 100px;
        background-color: var(--color-brand-primary);
        z-index: -1;
    }

    #hero-section {
        width: 80%;
        margin: 0 auto;

        @media (orientation: portrait) {
            width: 100%;
            flex-direction: column-reverse;
        }
    }
</style>

<section id="hero-section" class="full-page-section">
    <div class="flex flex-1 p-4 items-center justify-center">
        <div
            class="flex flex-col gap-4 bg-transparent backdrop-blur-sm p-8 rounded-lg border border-gray-200"
        >
            <p class="heading-4">Hello 👋</p>
            <div>
                <span class="heading-5 text-gray-500"
                    >Software Engineer & Cyclist</span
                >
                <h1 class="heading-1">Shane Wade</h1>
            </div>
            <p class="text-leading">
                I'm a software engineer and AI mechanic 🔧 🤖<br />
                I love bicycles and building products.
            </p>
            <div class="flex gap-4 justify-center">
                <button class="btn-primary"
                    ><a href="#contact-section">Get In Touch</a></button
                >
            </div>
        </div>
    </div>
    <div class="flex flex-1 items-center justify-center">
        <div class="image-wrapper">
            <Picture
                alt="Picture of Shane Wade with a bike"
                src={hero_photo}
                class="hero-image"
            />
        </div>
    </div>
</section>
