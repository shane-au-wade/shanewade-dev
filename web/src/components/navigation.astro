---
import "remixicon/fonts/remixicon.css";
import RetroClock from "@components/retro-clock.astro";
import DropdownMenu from "@components/dropdown-menu.astro";
import "@styles/components.css";

const navLinks: Array<{
    href: string;
    display_name: string;
    icon?: string;
}> = [
    {
        href: "#about-section",
        display_name: "About",
    },
    {
        href: "#projects-section",
        display_name: "Projects",
    },
    {
        href: "#bikes-section",
        display_name: "Bikes",
    },
    {
        href: "#contact-section",
        display_name: "Contact",
    },
    {
        href: "/recipes",
        display_name: "Recipes",
        icon: "ri-restaurant-2-line"
    },
];

// Transform navLinks for the dropdown component
const dropdownItems = navLinks.map((link) => ({
    href: link.href,
    label: link.display_name,
    icon: link.icon,
}));
---

<style>
    @font-face {
        font-family: "BoldPixels";
        src:
            url("/boldpixels/BoldPixels.ttf") format("truetype"),
            url("/boldpixels/BoldPixels.otf") format("opentype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }

    .hero-logo {
        font-family: "BoldPixels", sans-serif;
        text-decoration: none;
        font-size: 48px;
        @media screen and (min-width: 1000px) {
            font-size: 24px;
        }
    }

    .menu-icon {
        font-size: 48px;
        @media screen and (min-width: 1000px) {
            font-size: 24px;
        }
    }
</style>

<nav
    class="fixed top-0 left-0 right-0 w-full bg-transparent backdrop-blur-md border-b border-gray-200 dark:border-dark-border z-50"
>
    <div
        class="max-w-[1200px] mx-auto flex justify-between items-center gap-2 sm:gap-4 py-3 sm:px-4"
    >
        <a
            href="#hero-section"
            aria-label="Home"
            class="hero-logo px-2 text-brand-primary-dark hover:text-brand-primary-hover"
        >
            SW
        </a>

        <!-- Clock - hidden on very small screens, visible on sm and up -->
        <div class="hidden sm:flex flex-1 justify-center">
            <RetroClock />
        </div>

        <!-- Dropdown Menu -->
        <div class="">
            <DropdownMenu items={dropdownItems} buttonClass="btn-icon">
                <i class="ri-menu-3-line menu-icon"></i>
            </DropdownMenu>
        </div>
    </div>
</nav>
