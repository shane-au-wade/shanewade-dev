<style>
    .business-card {
        background-color: #f2f0ef;
        /* Subtle paper texture blend */
        background-blend-mode: multiply;
        background-size: 150px;

        /* Physical dimensions feel (aspect ratio 3.5/2) */
        aspect-ratio: 3.5 / 2;
        max-width: 400px;
        width: 100%;

        /* Ensure transform origin is center for rotation */
        transform-origin: center center;

        /* Real paper shadow */
        box-shadow: 
            /* Small rim shadow for thickness */
            1px 1px 0 0 rgba(210, 205, 195, 0.5),
            /* Soft ambient shadow */ 0 10px 20px -5px rgba(0, 0, 0, 0.1),
            0 20px 40px -10px rgba(0, 0, 0, 0.05);

        position: relative;
        overflow: hidden;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;

        /* Ink bleed effect for text */
        color: #2a2a2a;
    }

    .business-card-container {
        perspective: 1000px;
        max-width: 450px;
        width: 100%;
    }

    .business-card:hover {
        /* Transform is handled by JS now to preserve random rotation */
        box-shadow:
            1px 1px 0 0 rgba(210, 205, 195, 0.5),
            0 15px 30px -5px rgba(0, 0, 0, 0.15),
            0 30px 60px -15px rgba(0, 0, 0, 0.1);
    }

    /* Embossed/Letterpress effect for main text */
    .letterpress {
        color: rgba(40, 40, 40, 0.85);
        text-shadow: 0px 1px 1px rgba(255, 255, 255, 0.8);
    }

    .ink-text {
        color: #333;
        mix-blend-mode: multiply; /* Helps it look like ink on paper */
    }

    /* Subtle gradient overlay for lighting */
    .lighting {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.4) 0%,
            rgba(255, 255, 255, 0.1) 40%,
            rgba(0, 0, 0, 0.02) 100%
        );
        pointer-events: none;
    }

    /* Texture detail for the card edge */
    .edge-texture {
        position: absolute;
        inset: 0;
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 2px; /* Small rounded corners like die-cut */
        pointer-events: none;
    }

    @keyframes card-drop {
        0% {
            opacity: 0;
            transform: scale(1.2) translateY(-40px) rotate(-4deg);
        }
        /* End state is handled by JS/inline style */
    }
</style>

<div class="business-card-container mx-auto">
    <div
        class="business-card flex flex-col justify-between p-6 rounded-[2px] animate-[card-drop_0.8s_cubic-bezier(0.34,1.56,0.64,1)_0.5s_backwards] mx-auto"
        id="business-card"
    >
        <div class="lighting"></div>
        <div class="edge-texture"></div>

        <div class="relative z-10">
            <span
                class="block text-sm letterpress font-medium uppercase tracking-wider text-gray-500 mb-1 font-sans"
                >Software Engineer & Creative</span
            >
            <h1
                class="text-2xl md:text-3xl font-bold letterpress mb-2 text-gray-900"
            >
                Shane Wade
            </h1>
            <p class="text-base md:text-lg italic font-serif text-gray-600">
                "I want to help you build"
            </p>
        </div>

        <div class="relative z-10">
            <div
                class="flex gap-x-3 gap-y-2 flex-wrap text-xs md:text-sm font-medium text-gray-600 font-sans"
            >
                <span class="flex items-center gap-1">
                    <span class="w-1 h-1 bg-brand-primary rounded-full"></span>
                    AI Product Development
                </span>
                <span class="flex items-center gap-1">
                    <span class="w-1 h-1 bg-brand-primary rounded-full"></span>
                    Full-Stack Systems
                </span>
                <span class="flex items-center gap-1">
                    <span class="w-1 h-1 bg-brand-primary rounded-full"></span>
                    Workflow Automation
                </span>
                <span class="flex items-center gap-1">
                    <span class="w-1 h-1 bg-brand-primary rounded-full"></span>
                    Creative Side Projects
                </span>
            </div>
        </div>

    </div>
</div>

<script>
    // Randomize the final rotation of the card slightly to make it feel more organic
    const card = document.getElementById("business-card");
    if (card) {
        // Generate a random rotation between -2 and 2 degrees
        const randomRotation = Math.random() * 4 - 2;
        card.style.transform = `rotate(${randomRotation}deg)`;

        // We need to update the hover effect to respect this base rotation
        card.addEventListener("mouseenter", () => {
            card.style.transform = `translateY(-2px) rotate(${randomRotation + 0.5}deg)`;
        });

        card.addEventListener("mouseleave", () => {
            card.style.transform = `rotate(${randomRotation}deg)`;
        });
    }
</script>
