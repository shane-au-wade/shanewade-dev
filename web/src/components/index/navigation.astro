---
import "remixicon/fonts/remixicon.css";
import RetroClock from "@components/retro-clock.astro";
import DropdownMenu from "@components/dropdown-menu.astro";

const navLinks: Array<{
    href: string;
    display_name: string;
    icon?: string;
}> = [
    {
        href: "#about-section",
        display_name: "About",
    },
    {
        href: "#projects-section",
        display_name: "Projects",
    },
    {
        href: "/sf-bike-lanes",
        display_name: "SF Bike Lane Map",
        icon: "ri-map-2-line",
    },
    {
        href: "/recipes",
        display_name: "Recipes",
        icon: "ri-restaurant-2-line",
    },
    {
        href: "/design-system",
        display_name: "Design System",
        icon: "ri-palette-line",
    },
];

// Transform navLinks for the dropdown component
const dropdownItems = navLinks.map((link) => ({
    href: link.href,
    label: link.display_name,
    icon: link.icon,
}));
---

<style>
    .hero-logo {
        font-family: "BoldPixels", arial;
        text-decoration: none;
        font-size: 28px;
        @media screen and (min-width: 1000px) {
            font-size: 24px;
        }
    }

    .menu-icon {
        font-size: 28px;
        @media screen and (min-width: 1000px) {
            font-size: 20px;
        }
    }
</style>

<nav
    class=`fixed top-0 left-0 right-0 w-full bg-transparent backdrop-blur-md border-b border-gray-200 border-opacity-50 dark:border-dark-border z-50`
>
    <div
        class="max-w-[1200px] mx-auto flex justify-between items-center gap-2 sm:gap-4 px-2 sm:px-2 md:py-2"
    >
        <a
            id="home-button"
            href="#hero-section"
            aria-label="Home"
            class="hero-logo px-2 text-brand-primary-dark hover:text-brand-primary-hover cursor-pointer"
        >
            SW
        </a>

        <!-- Clock - hidden on very small screens, visible on sm and up -->
        <RetroClock />

        <!-- Dropdown Menu -->
        <DropdownMenu
            items={dropdownItems}
            buttonClass="h-fit w-[60px] flex justify-right"
        >
            <i class="ri-menu-3-line menu-icon"></i>
        </DropdownMenu>
    </div>
</nav>

<script>
    const homeButton = document.getElementById("home-button");
    if (homeButton) {
        // Add a class to the body when the navigation is fixed
        homeButton.addEventListener("click", (e) => {
            e.preventDefault();
            // ensure the url is updated to the home page
            window.history.pushState({}, "", "/");
            window.scrollTo({
                top: 0,
                behavior: "instant",
            });
        });
    }
</script>
