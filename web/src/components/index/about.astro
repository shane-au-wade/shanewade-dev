---
import "@styles/colors.css";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

import AboutImages from "./about-images.astro";
---

<section
    id="about-section"
    class="full-page-section flex-col bg-gray-100 dark:bg-dark-bg-secondary pt-20 px-3"
>
    <div class="max-w-[1200px] mx-auto w-full">
        <p
            class="uppercase tracking-wider text-sm text-gray-500 dark:text-dark-text-muted font-medium mb-6"
        >
            About Me
        </p>
        <h2 class="heading-2 mb-4">Engineer. Adventurer. Collaborator.</h2>

        <div class="flex flex-col gap-24">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
                <div class="order-2 md:order-1">
                    <p class="text-lead">
                        With over {new Date().getFullYear() - 2020} years of experience
                        in software engineering, I specialize in building high-performance
                        web apps and data pipelines for emerging AI technologies.
                        My work spans curating map data for autonomous semi-trucks, multi-UAV
                        control systems, and automated procurement software — always
                        with a focus on high quality systems and thoughtful user experiences.
                    </p>
                    <p class="text-lead mt-3">
                        Beyond the code, I love going on adventures and finding
                        space for creativity. I also build bikes (then ride
                        them) and I host a 60+ person annual camping trip with
                        my friends.
                    </p>
                    <p class="text-lead mt-3">
                        After going on a few adventures, it's obvious that the
                        key ingredient for success is the people around you.
                        Startups, camping, bike rides, parties <span
                            class="italic font-semibold"
                            >- it's the people that make the difference.</span
                        >
                    </p>
                    <div
                        class="hidden md:flex flex-wrap justify-center md:justify-start gap-2 mt-4"
                    >
                        <a
                            href="https://www.linkedin.com/in/shane-au-wade/details/experience/"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-linkedin-box-fill"></i>
                            Experience Details
                        </a>
                        <a
                            href="/Shane-Wade-Software-Engineer.pdf"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-download-line"></i>
                            Download Resume
                        </a>
                    </div>
                </div>

                <div class="order-1 md:order-2">
                    <AboutImages />
                    <div
                        class="flex md:hidden flex-wrap justify-center md:justify-start gap-2 mt-4"
                    >
                        <a
                            href="https://www.linkedin.com/in/shane-au-wade/details/experience/"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-linkedin-box-fill"></i>
                            Experience Details
                        </a>
                        <a
                            href="/Shane-Wade-Software-Engineer.pdf"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-download-line"></i>
                            Download Resume
                        </a>
                    </div>
                </div>
            </div>
            <div class="md:hidden"></div>
        </div>
    </div>
</section>
