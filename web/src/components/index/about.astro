---
import "@styles/colors.css";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

import ShaneWadeHeadshotWhiteBg from "@images/sw-headshot-2025-white-bg.png";
import ShaneWadeHeadshotRedBg from "@images/sw-headshot-2025-red-bg.png";
---

<section
    id="about-section"
    class="full-page-section flex-col bg-gray-100 dark:bg-dark-bg-secondary pt-20 px-2"
>
    <div class="max-w-[1200px] mx-auto w-full">
        <p
            class="uppercase tracking-wider text-sm text-gray-500 dark:text-dark-text-muted font-medium mb-6"
        >
            About Me
        </p>
        <h2 class="heading-2 mb-4">Engineer. Cyclist. Problem Solver.</h2>

        <div class="flex flex-col gap-24">
            <!-- Block 1: General/Intro -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-center">
                <div class="order-2 md:order-1">
                    <p class="text-lead">
                        With over {new Date().getFullYear() - 2020} years of experience
                        in software engineering, I specialize in building high-performance
                        web apps and AI data pipelines for niche markets. My work
                        spans geospatial data for autonomous semi-trucks, multi-UAV
                        control systems, and enterprise procurment software — always
                        with a focus on high quality systems and thoughtful user
                        experiences.
                    </p>

                </div>

                <div class="order-1 md:order-2">
                    <!-- Placeholder: Replace with general work/coding photo -->
                    <img
                        src={ShaneWadeHeadshotWhiteBg.src}
                        alt="Shane Wade"
                        class="w-full h-auto rounded-2xl shadow-lg object-cover aspect-[4/3] mb-4"
                    />
                    <div class="flex flex-wrap justify-center gap-2">
                        <a
                            href="https://www.linkedin.com/in/shane-au-wade/details/experience/"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-linkedin-box-fill"></i>
                            Experience Details
                        </a>
                        <a
                            href="/Shane-Wade-Software-Engineer.pdf"
                            target="_blank"
                            class="btn-primary btn-sm"
                        >
                            <i class="ri-download-line"></i>
                            Download Resume
                        </a>
                    </div>
                </div>
            </div>

            <!-- Block 2: Embark/UAV -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="order-1">
                    <!-- Placeholder: Replace with specific project photo (Trucks/UAVs) -->
                    <img
                        src={ShaneWadeHeadshotRedBg.src}
                        alt="Engineering Projects"
                        class="w-full h-auto rounded-2xl shadow-lg object-cover aspect-[4/3]"
                    />
                </div>
                <div class="order-2">
                    <p class="text-lead mb-0">
                        At Embark Trucks, I certified 500+ miles of US highway
                        data for their autonomous vehicle system, contributing
                        to zero on-road incidents. I designed and delivered a
                        multi-UAV control system 10 days before Threshold UAV's
                        debut at AgSmart 2023. I'm adaptable, self-motivated,
                        and have a strong track record of delivering projects on
                        time while exceeding expectations.
                    </p>
                </div>
            </div>

            <!-- Block 3: Cycling -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="order-2 md:order-1">
                    <p class="text-lead mb-0">
                        When I'm not coding, you'll find me on my bike—whether
                        it's grinding up mountain passes, exploring gravel
                        roads, or commuting through San Francisco. Cycling has
                        taught me patience, persistence, and the value of steady
                        progress—principles I bring to every project.
                    </p>
                </div>
                <div class="order-1 md:order-2">
                    <!-- Placeholder: Replace with cycling photo -->
                    <img
                        src="/images/sw-headshot-2025-red-bg.png"
                        alt="Cycling Adventures"
                        class="w-full h-auto rounded-2xl shadow-lg object-cover aspect-[4/3]"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
