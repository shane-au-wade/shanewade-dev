---
import "@styles/colors.css";
import "@styles/components.css";

// import { Image } from "astro:assets";
import hero_photo from "@images/sw-headshot-2025.png";
import BusinessCard from "./business-card.astro";
import LearnMore from "./learn-more.astro";
---

<style>
    .image-wrapper {
        padding: 1rem;
        max-width: 350px;
        width: fit-content;
        position: relative;
    }

    .image-wrapper::before {
        content: "";
        position: absolute;
        top: -20px;
        right: -20px;
        width: 150px;
        height: 150px;
        background-color: var(--color-brand-primary-dark);
        z-index: -1;
    }

    .image-wrapper::after {
        content: "";
        position: absolute;
        bottom: 0px;
        left: -20px;
        width: 100px;
        height: 100px;
        background-color: var(--color-brand-primary);
        z-index: -1;
    }

    #hero-section {
        width: 80%;
        margin: 0 auto;

        @media (orientation: portrait) {
            width: 100%;
            flex-direction: column;
        }
    }
</style>

<section id="hero-section" class="full-page-section pt-[64px]">
    <div class="flex flex-col gap-12 flex-1 p-2 items-center justify-center">
        <div class="px-1 mt-12 md:mt-0">
            <h2 class="heading-1 text-center">
                I ship <span class="text-brand-primary italic"
                    >practical solutions</span
                > today
                <br /> and <span class="text-brand-primary italic"
                    >reliable systems</span
                > tomorrow.
            </h2>
        </div>
        <BusinessCard />
        <div class="flex flex-col gap-2 justify-center">
            <LearnMore />
            <div class="flex flex-row gap-1">
                <a
                    href="https://github.com/shane-au-wade"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                >
                    <button class="btn-ghost-primary btn-icon w-16">
                        <i class=`ri-github-fill text-[32px]`></i>
                    </button>
                </a>

                <a
                    href="https://www.linkedin.com/in/shane-au-wade"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                >
                    <button class="btn-ghost-primary btn-icon w-16">
                        <i class=`ri-linkedin-box-fill text-[32px]`></i>
                    </button>
                </a>
            </div>
        </div>
    </div>

    <div
        class="flex flex-1 items-center justify-center mb-8 md:mb-0 mt-12 md:mt-0"
    >
        <div class="image-wrapper">
            <img
                alt="Headshot of Shane Wade smiling"
                loading="eager"
                src={hero_photo.src}
                class="hero-image"
            />
            <p class="text-body italic text-center">"Pleasure to meet you!"</p>
        </div>
    </div>
</section>
