---

<div class="flex flex-col">
    <section
        id="image-carousel"
        data-interval="4000"
        class="flex overflow-x-auto rounded-md snap-x snap-mandatory outline outline-1 outline-gray-200 mx-auto aspect-[5/4] max-w-[100vw]"
    >
        {
            images.map((image) => (
                <Image
                    loading="lazy"
                    width={1920}
                    height={1080}
                    src={image.src}
                    alt={image.alt}
                    class="aspect-[5/4] object-cover snap-center"
                />
            ))
        }
    </section>
    <div class="flex justify-center p-4">
        <div class="flex gap-2 items-center" id="carousel-dots">
            {
                images.map((_, index) => (
                    <span
                        class:list={[
                            "carousel-dot rounded-full transition-all duration-300",
                            index === 0
                                ? "h-2.5 w-2.5 bg-brand-primary"
                                : "h-2 w-2 bg-gray-400",
                        ]}
                    />
                ))
            }
        </div>
    </div>
</div>

<script>
    const carousel = document.getElementById("image-carousel");
    const dots = document.querySelectorAll(".carousel-dot");

    if (carousel && dots.length > 0) {
        let scrollInterval: ReturnType<typeof setInterval> | null = null;
        const intervalTime = parseInt(carousel.dataset.interval || "4000");

        const updateDots = () => {
            const scrollLeft = carousel.scrollLeft;
            const width = carousel.clientWidth;
            const activeIndex = Math.round(scrollLeft / width);

            dots.forEach((dot, index) => {
                if (index === activeIndex) {
                    // Active state
                    dot.classList.remove("bg-gray-400", "h-2", "w-2");
                    dot.classList.add("bg-brand-primary", "h-2.5", "w-2.5");
                } else {
                    // Inactive state
                    dot.classList.remove("bg-brand-primary", "h-2.5", "w-2.5");
                    dot.classList.add("bg-gray-400", "h-2", "w-2");
                }
            });
        };

        const nextSlide = () => {
            const scrollLeft = carousel.scrollLeft;
            const width = carousel.clientWidth;
            const activeIndex = Math.round(scrollLeft / width);
            const nextIndex = (activeIndex + 1) % dots.length;

            carousel.scrollTo({
                left: width * nextIndex,
                behavior: "smooth",
            });
        };

        const startLoop = () => {
            if (scrollInterval) return;
            scrollInterval = setInterval(nextSlide, intervalTime);
        };

        const stopLoop = () => {
            if (scrollInterval) {
                clearInterval(scrollInterval);
                scrollInterval = null;
            }
        };

        carousel.addEventListener("scroll", updateDots);

        // Pause on interaction
        carousel.addEventListener("mouseenter", stopLoop);
        carousel.addEventListener("mouseleave", startLoop);
        carousel.addEventListener("touchstart", stopLoop, { passive: true });
        carousel.addEventListener("touchend", startLoop, { passive: true });

        // Start the loop
        startLoop();

        // Optional: Add click handlers to dots to scroll to image
        dots.forEach((dot, index) => {
            dot.addEventListener("click", () => {
                // Stop loop when manually navigating
                stopLoop();

                const width = carousel.clientWidth;
                carousel.scrollTo({
                    left: width * index,
                    behavior: "smooth",
                });

                // Restart loop after a short delay or let mouseleave handle it
                // If clicked via touch, mouseleave might not fire, so we rely on subsequent interaction or just restart
                // But better to let user control it. If they hovered to click, mouseleave will restart it.
            });
        });
    }
</script>
