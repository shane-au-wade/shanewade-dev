---
export interface Props {
    items: Array<{
        href: string;
        label: string;
        icon?: string;
    }>;
    buttonClass?: string;
    ariaLabel?: string;
}

const { items, buttonClass = "btn-default", ariaLabel = "Menu" } = Astro.props;
---

<style>
    .dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        background-color: white;
        box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
        z-index: 100;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        min-width: fit-content;
    }

    .dropdown-content a {
        color: #111827;
        padding: 8px 12px;
        text-decoration: none;
        display: flex;
        gap: 10px;
        width: 100%;
        white-space: nowrap;
        font-size: 1rem;
        @media screen and (min-width: 1000px) {
            font-size: 1rem;
        }
    }

    .dropdown-content a:hover {
        background-color: #f3f4f6;
    }

    /* Show dropdown when open class is added */
    .dropdown-content.open {
        display: block;
    }

    /* Keep hover functionality for desktop */
    @media (hover: hover) and (pointer: fine) {
        .dropdown:hover .dropdown-content {
            display: block;
        }
    }

    /* Dark mode support */
    @media (prefers-color-scheme: dark) {
        .dropdown-content {
            background-color: #1f2937;
            border-color: #374151;
        }

        .dropdown-content a {
            color: #d1d5db;
        }

        .dropdown-content a:hover {
            background-color: #374151;
        }
    }
</style>

<div class="dropdown">
    <button
        class={buttonClass}
        aria-haspopup="true"
        aria-expanded="false"
        type="button"
        data-dropdown-button
    >
        <slot />
    </button>
    <div
        class="dropdown-content"
        role="menu"
        aria-label={ariaLabel}
        data-dropdown-menu
    >
        {
            items.map((item) => (
                <a href={item.href} role="menuitem">
                    {item.icon && <i class={item.icon} />}
                    <span>{item.label}</span>
                </a>
            ))
        }
    </div>
</div>

<script>
    // Initialize dropdown functionality for all dropdowns on the page
    function initDropdowns() {
        const dropdowns = document.querySelectorAll("[data-dropdown-button]");

        dropdowns.forEach((button) => {
            const dropdown = button.closest(".dropdown");
            const menu = dropdown?.querySelector("[data-dropdown-menu]");

            if (!menu) return;

            // Toggle dropdown on button click
            button.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = menu.classList.contains("open");

                // Close all other dropdowns
                document
                    .querySelectorAll("[data-dropdown-menu]")
                    .forEach((m) => {
                        if (m !== menu) {
                            m.classList.remove("open");
                            const btn = m
                                .closest(".dropdown")
                                ?.querySelector("[data-dropdown-button]");
                            btn?.setAttribute("aria-expanded", "false");
                        }
                    });

                // Toggle current dropdown
                menu.classList.toggle("open");
                button.setAttribute("aria-expanded", (!isOpen).toString());
            });
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (!target.closest(".dropdown")) {
                document
                    .querySelectorAll("[data-dropdown-menu]")
                    .forEach((menu) => {
                        menu.classList.remove("open");
                        const btn = menu
                            .closest(".dropdown")
                            ?.querySelector("[data-dropdown-button]");
                        btn?.setAttribute("aria-expanded", "false");
                    });
            }
        });

        // Close dropdown on escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                document
                    .querySelectorAll("[data-dropdown-menu]")
                    .forEach((menu) => {
                        menu.classList.remove("open");
                        const btn = menu
                            .closest(".dropdown")
                            ?.querySelector("[data-dropdown-button]");
                        btn?.setAttribute("aria-expanded", "false");
                    });
            }
        });
    }

    // Initialize on page load
    initDropdowns();

    // Re-initialize after page transitions (for SPAs or view transitions)
    document.addEventListener("astro:after-swap", initDropdowns);
</script>
