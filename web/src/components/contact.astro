---
import "@styles/colors.css";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

import CopyButton from "@components/copy-button.astro";
---

<section
    id="contact-section"
    class="full-page-section flex-col bg-white dark:bg-dark-bg py-32 px-8 text-center"
>
    <div class="max-w-[800px] mx-auto w-full">
        <p
            class="uppercase tracking-wider text-sm text-gray-500 dark:text-dark-text-muted font-medium mb-6"
        >
            Get In Touch
        </p>
        <h2 class="heading-2 mb-6">Let's Build Something Together</h2>
        <p class="text-lead mb-12 text-gray-700 dark:text-dark-text-secondary">
            Whether you have a project in mind, want to discuss cycling routes,
            or just want to connect—I'd love to hear from you.
        </p>

        <div
            class="bg-gray-100 dark:bg-dark-bg-elevated border border-gray-200 dark:border-dark-border rounded-lg p-12 mb-12"
        >
            <div
                class="w-16 h-16 mx-auto mb-6 flex items-center justify-center"
            >
                <i class="ri-mail-ai-line heading-1"></i>
            </div>
            <h3 class="heading-3">Email Me<sup>*</sup></h3>
            <p class="text-sub mb-8">The best way to reach me is via email.</p>
            <p class="text-lead mb-8">shane.au.wade@gmail.com</p>

            <p class="flex gap-4 flex-wrap justify-center items-center">
                <a href="mailto:shane.au.wade@gmail.com" class="btn-primary">
                    <i class="ri-mail-send-line"></i>
                </a>

                <CopyButton text="shane.au.wade@gmail.com" />
            </p>
        </div>
    </div>

    <div class="flex gap-4 justify-center items-center">
        <a
            href="https://github.com/shane-au-wade"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-12 h-12 border border-gray-200 dark:border-dark-border rounded-md transition-all duration-200 bg-white dark:bg-dark-bg-elevated hover:border-brand-primary hover:bg-gray-50 dark:hover:bg-dark-bg-hover hover:-translate-y-0.5"
            aria-label="GitHub"
        >
            <img src="/github-mark.svg" alt="GitHub" class="w-6 h-6" />
        </a>
        <a
            href="https://www.linkedin.com/in/shane-au-wade"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-12 h-12 border border-gray-200 dark:border-dark-border rounded-md transition-all duration-200 bg-white dark:bg-dark-bg-elevated hover:border-brand-primary hover:bg-gray-50 dark:hover:bg-dark-bg-hover hover:-translate-y-0.5"
            aria-label="LinkedIn"
        >
            <img src="/linkedin.svg" alt="LinkedIn" class="w-6 h-6" />
        </a>
    </div>
</section>
