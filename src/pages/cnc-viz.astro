---
import Head from "@components/head.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
import ThemeToggle from "@components/theme-toggle.astro";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";
---

<html lang="en">
    <Head title="CNC Spectrogram - Shane Wade" />
    <body
        class="bg-page dark:bg-dark-bg min-h-screen transition-colors duration-300 overflow-hidden font-sans"
    >
        <!-- Floating Controls Header -->
        <header
            id="controls-panel"
            class="fixed top-4 left-4 z-50 flex flex-col gap-3 p-4 bg-white/92 dark:bg-dark-bg-elevated/92 backdrop-blur-md rounded-xl shadow-lg border border-gray-200 dark:border-dark-border w-72 transition-opacity duration-300 hover:opacity-100 opacity-85"
        >
            <div class="flex items-center justify-between gap-2">
                <div>
                    <Breadcrumbs />
                    <p class="text-xs text-muted mt-0.5">CNC Audio Analyzer</p>
                </div>
                <ThemeToggle />
            </div>

            <!-- Status Badge -->
            <div class="flex items-center gap-2">
                <span id="status-badge" class="badge-secondary flex items-center gap-1.5">
                    <span id="status-dot" class="w-1.5 h-1.5 rounded-full bg-gray-400 inline-block"></span>
                    <span id="status-text">Idle</span>
                </span>
                <span id="duration-display" class="text-xs text-muted font-mono ml-auto hidden">00:00.0</span>
            </div>

            <!-- Transport Controls -->
            <div class="flex gap-2">
                <button
                    id="btn-record"
                    class="btn-primary btn-sm flex-1 flex items-center justify-center gap-1.5"
                    title="Start recording"
                >
                    <i class="ri-record-circle-line"></i>
                    Record
                </button>
                <button
                    id="btn-stop"
                    class="btn-default btn-sm flex-1 flex items-center justify-center gap-1.5"
                    disabled
                    title="Stop"
                >
                    <i class="ri-stop-circle-line"></i>
                    Stop
                </button>
            </div>

            <div class="flex gap-2">
                <button
                    id="btn-play"
                    class="btn-outline btn-sm flex-1 flex items-center justify-center gap-1.5"
                    disabled
                    title="Play recording"
                >
                    <i class="ri-play-circle-line"></i>
                    Play
                </button>
                <button
                    id="btn-download"
                    class="btn-ghost btn-sm flex-1 flex items-center justify-center gap-1.5"
                    disabled
                    title="Download recording"
                >
                    <i class="ri-download-line"></i>
                    Save
                </button>
            </div>

            <!-- Visualization Controls -->
            <div class="pt-2 border-t border-gray-200 dark:border-gray-700 space-y-2.5">
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider" for="sensitivity">
                            Sensitivity
                        </label>
                        <span class="text-xs text-muted font-mono">[ / ]</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <button
                            id="sensitivity-dec"
                            class="btn-default btn-sm btn-icon w-7 h-7 flex items-center justify-center shrink-0 text-base leading-none"
                            aria-label="Decrease sensitivity"
                            title="Decrease ([ key)"
                        >−</button>
                        <input
                            type="number"
                            id="sensitivity"
                            min="0.1"
                            max="20"
                            step="0.1"
                            value="0.6"
                            class="input text-center font-mono text-sm h-7 px-1 flex-1 min-w-0"
                        />
                        <button
                            id="sensitivity-inc"
                            class="btn-default btn-sm btn-icon w-7 h-7 flex items-center justify-center shrink-0 text-base leading-none"
                            aria-label="Increase sensitivity"
                            title="Increase (] key)"
                        >+</button>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1 block">
                        Smoothing
                    </label>
                    <input
                        type="range"
                        id="smoothing"
                        min="0"
                        max="0.95"
                        step="0.05"
                        value="0"
                        class="w-full accent-brand-primary"
                    />
                </div>
                <div>
                    <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1 block">
                        Camera Angle
                    </label>
                    <input
                        type="range"
                        id="camera-angle"
                        min="0"
                        max="45"
                        step="1"
                        value="3"
                        class="w-full accent-brand-primary"
                    />
                </div>
            </div>

            <!-- Mic selector -->
            <div>
                <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1 block">
                    Input Device
                </label>
                <select id="mic-select" class="select text-sm w-full">
                    <option value="">Default Microphone</option>
                </select>
            </div>

            <p class="text-xs text-muted">Click <strong>Record</strong> to begin capturing audio.</p>
        </header>

        <!-- Projected frequency axis overlay (populated by JS) -->
        <svg
            id="axis-overlay"
            class="fixed inset-0 z-30 pointer-events-none"
            width="100%"
            height="100%"
            aria-hidden="true"
        ></svg>

        <!-- Three.js mount point -->
        <div id="spectrogram-mount" class="w-full h-screen"></div>

        <!-- Scrub Bar (hidden until recording begins) -->
        <div
            id="scrub-bar"
            class="hidden fixed bottom-0 left-0 right-0 z-40 bg-black/80 backdrop-blur-md border-t border-white/10 px-4 py-2.5"
        >
            <div class="flex items-center gap-3">
                <!-- Left timestamp (oldest visible slice) -->
                <span id="scrub-time-left" class="text-xs font-mono text-white/50 w-12 shrink-0 text-right">00:00</span>

                <!-- Timeline track -->
                <div class="relative flex-1 group">
                    <!-- Background track -->
                    <div class="absolute inset-0 flex items-center pointer-events-none">
                        <div class="w-full h-1 bg-white/10 rounded-full"></div>
                    </div>
                    <!-- Viewport window indicator (positioned by JS) -->
                    <div
                        id="scrub-window"
                        class="absolute top-1/2 -translate-y-1/2 h-1 bg-white/25 rounded-full pointer-events-none transition-none"
                        style="left: 0%; width: 100%"
                    ></div>
                    <!-- Range input (transparent, sits on top) -->
                    <input
                        type="range"
                        id="scrub-input"
                        min="0"
                        max="0"
                        value="0"
                        step="1"
                        class="relative w-full h-5 cursor-pointer"
                        aria-label="Scrub timeline"
                    />
                </div>

                <!-- Right timestamp (newest available) -->
                <span id="scrub-time-right" class="text-xs font-mono text-white/50 w-12 shrink-0">00:00</span>

                <!-- Live button -->
                <button
                    id="btn-live"
                    class="hidden btn-primary btn-sm shrink-0 flex items-center gap-1"
                    title="Jump to live (End key)"
                >
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 recording-dot inline-block"></span>
                    Live
                </button>
            </div>

            <!-- Current viewport position label -->
            <div class="flex justify-center mt-0.5">
                <span id="scrub-time-current" class="text-xs font-mono text-white/30">──</span>
            </div>
        </div>

        <!-- No mic alert -->
        <div
            id="no-mic-alert"
            class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 alert-warning z-50 max-w-md text-center"
        >
            <i class="ri-mic-off-line mr-1"></i>
            Microphone access denied or unavailable. Please allow microphone permissions and refresh.
        </div>
    </body>
</html>

<style>
    body {
        overscroll-behavior: none;
    }

    #spectrogram-mount canvas {
        display: block;
    }

    /* Scrub range input: invisible track/thumb — the visual track is in the DOM */
    #scrub-input {
        -webkit-appearance: none;
        appearance: none;
        background: transparent;
    }
    #scrub-input::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: rgba(255,255,255,0.7);
        cursor: grab;
        border: 2px solid rgba(255,255,255,0.3);
        box-shadow: 0 0 4px rgba(0,0,0,0.5);
        opacity: 1;
    }
    #scrub-input:active::-webkit-slider-thumb {
        cursor: grabbing;
        background: white;
    }
    #scrub-input::-webkit-slider-runnable-track {
        background: transparent;
    }

    button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
        pointer-events: none;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.2; }
    }

    .recording-dot {
        animation: pulse-dot 1s ease-in-out infinite;
        background-color: #ef4444 !important;
    }

    .playing-dot {
        animation: pulse-dot 0.6s ease-in-out infinite;
        background-color: #22c55e !important;
    }
</style>

<script>
    import * as THREE from "three";

    // ─── Config ──────────────────────────────────────────────────────────────────

    const FREQ_SAMPLES = 512;      // Y resolution (frequency bins)
    const TIME_SAMPLES = 900;      // X resolution (time slices visible in mesh)
    const N_VERTICES = (FREQ_SAMPLES + 1) * (TIME_SAMPLES + 1);
    const XSIZE = 32;
    const YSIZE = 18;

    // Ring buffer: ~9 min of history at 60fps. 32400 × 512 ≈ 16.6 MB
    const MAX_HISTORY = 32400;

    // ─── State ────────────────────────────────────────────────────────────────────

    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let micSource: MediaStreamAudioSourceNode | null = null;
    let playbackSource: AudioBufferSourceNode | null = null;
    let mediaRecorder: MediaRecorder | null = null;
    let recordedChunks: Blob[] = [];
    let recordedBlob: Blob | null = null;
    let micStream: MediaStream | null = null;

    let isRecording = false;
    let isPlaying = false;
    let recordingStartTime = 0;
    let durationTimer: ReturnType<typeof setInterval> | null = null;

    let sensitivity = 0.6;
    let cameraAngle = 2; // degrees of elevation above the flat front view
    let smoothing = 0; // matches the default slider value (crisp viz)

    const DATA = new Uint8Array(FREQ_SAMPLES);
    const heights = new Uint8Array(N_VERTICES);

    // ─── Ring Buffer State ────────────────────────────────────────────────────────

    const ringBuffer = new Uint8Array(MAX_HISTORY * FREQ_SAMPLES);
    let ringHead = 0;        // next write slot (wraps mod MAX_HISTORY)
    let totalSlices = 0;     // monotonic count of slices written during recording
    let isLive = true;       // when true, viewport pins to the newest slice

    // ─── Playback State ───────────────────────────────────────────────────────────

    let recordedSlices = 0;          // snapshot of totalSlices at stopRecording()
    let recordedDurationMs = 0;      // wall-clock duration of the recording
    let cachedAudioBuffer: AudioBuffer | null = null;
    let playbackStartCtxTime = 0;    // audioCtx.currentTime when current play() began
    let playbackStartSlice = 0;      // absolute slice index where playback started

    // ─── Three.js Setup ──────────────────────────────────────────────────────────

    const mount = document.getElementById("spectrogram-mount")!;

    const camera = new THREE.PerspectiveCamera(27, window.innerWidth / window.innerHeight, 0.1, 1000);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a0f);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(window.innerWidth, window.innerHeight);
    mount.appendChild(renderer.domElement);

    // ─── Geometry ────────────────────────────────────────────────────────────────

    const xsegments = TIME_SAMPLES;
    const ysegments = FREQ_SAMPLES;
    const xhalfSize = XSIZE / 2;
    const yhalfSize = YSIZE / 2;
    const xsegmentSize = XSIZE / xsegments;

    // Logarithmic Y spacing to match human pitch perception
    const ypow_max = Math.log(YSIZE);
    const ybase = Math.E;

    const geometry = new THREE.BufferGeometry();
    const vertices: number[] = [];
    const indices: number[] = [];

    for (let i = 0; i <= xsegments; i++) {
        const x = i * xsegmentSize - xhalfSize;
        for (let j = 0; j <= ysegments; j++) {
            const powr = ((ysegments - j) / ysegments) * ypow_max;
            const y = -Math.pow(ybase, powr) + yhalfSize + 1;
            vertices.push(x, y, 0);
        }
    }

    for (let i = 0; i < xsegments; i++) {
        for (let j = 0; j < ysegments; j++) {
            const a = i * (ysegments + 1) + (j + 1);
            const b = i * (ysegments + 1) + j;
            const c = (i + 1) * (ysegments + 1) + j;
            const d = (i + 1) * (ysegments + 1) + (j + 1);
            indices.push(a, b, d);
            indices.push(b, c, d);
        }
    }

    geometry.setAttribute("position", new THREE.Float32BufferAttribute(vertices, 3));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();

    // ─── Turbo Colormap LUT ───────────────────────────────────────────────────────
    // A perceptually uniform colormap: black → deep blue → cyan → green → yellow → red → white

    function buildTurboLUT(): THREE.Vector3[] {
        // Compact turbo colormap: 32 control points, interpolated to 256
        const keyframes: [number, number, number][] = [
            [0.18995, 0.07176, 0.23217],
            [0.24427, 0.60937, 0.99697],
            [0.13886, 0.76279, 0.89550],
            [0.09320, 0.87211, 0.75237],
            [0.17377, 0.94053, 0.61938],
            [0.38127, 0.98909, 0.42386],
            [0.57357, 0.99817, 0.27712],
            [0.74617, 0.95593, 0.20406],
            [0.90605, 0.84337, 0.22188],
            [0.98986, 0.69382, 0.21043],
            [0.99672, 0.60977, 0.17842],
            [0.98108, 0.48104, 0.12332],
            [0.92623, 0.32473, 0.05837],
            [0.81608, 0.18462, 0.01809],
            [0.63082, 0.06868, 0.00401],
            [0.47960, 0.01583, 0.01055],
        ];

        const lut: THREE.Vector3[] = [];
        for (let n = 0; n < 256; n++) {
            const t = n / 255;
            const scaledT = t * (keyframes.length - 1);
            const lo = Math.floor(scaledT);
            const hi = Math.min(lo + 1, keyframes.length - 1);
            const alpha = scaledT - lo;
            const r = keyframes[lo][0] + alpha * (keyframes[hi][0] - keyframes[lo][0]);
            const g = keyframes[lo][1] + alpha * (keyframes[hi][1] - keyframes[lo][1]);
            const b = keyframes[lo][2] + alpha * (keyframes[hi][2] - keyframes[lo][2]);
            lut.push(new THREE.Vector3(r, g, b));
        }
        return lut;
    }

    const lut = buildTurboLUT();

    // ─── Shaders ─────────────────────────────────────────────────────────────────

    const vertexShader = /* glsl */`
        attribute float displacement;
        uniform float uSensitivity;
        uniform vec3 vLut[256];
        varying vec3 vColor;

        void main() {
            float d = clamp(displacement * uSensitivity, 0.0, 255.0);
            int index = int(d);
            vColor = vLut[index];
            vec3 newPosition = position + normal * d / 28.0;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(newPosition, 1.0);
        }
    `;

    const fragmentShader = /* glsl */`
        varying vec3 vColor;

        void main() {
            gl_FragColor = vec4(vColor, 1.0);
        }
    `;

    const uniforms = {
        vLut: { value: lut },
        uSensitivity: { value: sensitivity },
    };

    const material = new THREE.ShaderMaterial({
        uniforms,
        vertexShader,
        fragmentShader,
    });

    geometry.setAttribute("displacement", new THREE.Uint8BufferAttribute(heights, 1));

    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);


    // ─── Camera Position ──────────────────────────────────────────────────────────

    function updateCamera(angleDeg: number) {
        // angleDeg=0: camera dead-on along Z axis (flat front view of frequency×time plane)
        // angleDeg>0: slight upward elevation to reveal 3D amplitude displacement
        const rad = THREE.MathUtils.degToRad(angleDeg);
        const dist = 50;
        camera.position.set(0, Math.sin(rad) * dist, Math.cos(rad) * dist);
        // Offset lookAt slightly downward so mesh is vertically centered at this elevation
        camera.lookAt(0, -Math.sin(rad) * 2, 0);
    }

    updateCamera(cameraAngle);

    // ─── Frequency Axis Overlay ───────────────────────────────────────────────────

    const SVG_NS = "http://www.w3.org/2000/svg";

    // Updated to audioCtx.sampleRate once audio starts; default covers most hardware
    let sampleRate = 48000;

    // Key frequencies relevant to CNC audio analysis
    const TICK_FREQS: { hz: number; label: string; major: boolean }[] = [
        { hz: 60,    label: "60 Hz",   major: false },
        { hz: 120,   label: "120 Hz",  major: false },
        { hz: 250,   label: "250 Hz",  major: true  },
        { hz: 500,   label: "500 Hz",  major: false },
        { hz: 1000,  label: "1 kHz",   major: true  },
        { hz: 2000,  label: "2 kHz",   major: false },
        { hz: 4000,  label: "4 kHz",   major: true  },
        { hz: 8000,  label: "8 kHz",   major: false },
        { hz: 12000, label: "12 kHz",  major: true  },
    ];

    // Convert a frequency in Hz to the world-space Y of its vertex row.
    // Returns null if the frequency is out of the captured FFT range.
    function freqToWorldY(hz: number): number | null {
        const fftSize = 4 * FREQ_SAMPLES; // e.g. 2048
        const binHz = sampleRate / fftSize;
        const binIndex = Math.round(hz / binHz);
        if (binIndex < 0 || binIndex >= FREQ_SAMPLES) return null;
        // Mirror of the geometry construction loop
        const powr = ((ysegments - binIndex) / ysegments) * ypow_max;
        return -Math.pow(ybase, powr) + yhalfSize + 1;
    }

    // Project a world-space point to screen pixel coordinates via the active camera.
    function worldToScreen(worldX: number, worldY: number, worldZ = 0): { x: number; y: number } {
        const vec = new THREE.Vector3(worldX, worldY, worldZ);
        vec.project(camera); // NDC: x,y ∈ [-1, 1]
        return {
            x: (vec.x * 0.5 + 0.5) * window.innerWidth,
            y: (-vec.y * 0.5 + 0.5) * window.innerHeight,
        };
    }

    function updateAxisOverlay() {
        const svg = document.getElementById("axis-overlay") as unknown as SVGSVGElement | null;
        if (!svg) return;

        // Wipe and resize
        svg.innerHTML = "";
        svg.setAttribute("width", String(window.innerWidth));
        svg.setAttribute("height", String(window.innerHeight));

        // Avoid drawing over the control panel on the left
        const LEFT_CLAMP = 296;
        const maxFreq = sampleRate / 4; // Nyquist of our captured bins

        for (const { hz, label, major } of TICK_FREQS) {
            if (hz > maxFreq) continue;

            const worldY = freqToWorldY(hz);
            if (worldY === null) continue;

            // Project the left and right mesh edges at this frequency row.
            // This gives perspective-correct angled tick lines that follow the mesh geometry.
            const leftPt  = worldToScreen(-xhalfSize, worldY);
            const rightPt = worldToScreen( xhalfSize, worldY);

            // Clamp left edge to avoid the controls panel
            const x1 = Math.max(LEFT_CLAMP, leftPt.x);
            const y1 = leftPt.y + (rightPt.y - leftPt.y) *
                       ((x1 - leftPt.x) / (rightPt.x - leftPt.x || 1));

            // Skip if both edges are off-screen vertically
            if (rightPt.y < -20 || rightPt.y > window.innerHeight + 20) continue;

            // ── Tick line across the mesh ────────────────────────────────────────
            const line = document.createElementNS(SVG_NS, "line");
            line.setAttribute("x1", x1.toFixed(1));
            line.setAttribute("y1", y1.toFixed(1));
            line.setAttribute("x2", rightPt.x.toFixed(1));
            line.setAttribute("y2", rightPt.y.toFixed(1));
            line.setAttribute("stroke", major ? "rgba(255,255,255,0.22)" : "rgba(255,255,255,0.10)");
            line.setAttribute("stroke-width", major ? "1" : "0.75");
            line.setAttribute("stroke-dasharray", major ? "6 5" : "3 6");
            svg.appendChild(line);

            // ── Right-edge tick nub ──────────────────────────────────────────────
            const nub = document.createElementNS(SVG_NS, "line");
            nub.setAttribute("x1", rightPt.x.toFixed(1));
            nub.setAttribute("y1", rightPt.y.toFixed(1));
            nub.setAttribute("x2", (rightPt.x + 8).toFixed(1));
            nub.setAttribute("y2", rightPt.y.toFixed(1));
            nub.setAttribute("stroke", major ? "rgba(255,255,255,0.75)" : "rgba(255,255,255,0.40)");
            nub.setAttribute("stroke-width", major ? "1.5" : "1");
            svg.appendChild(nub);

            // ── Frequency label ──────────────────────────────────────────────────
            const text = document.createElementNS(SVG_NS, "text");
            text.setAttribute("x", (rightPt.x + 14).toFixed(1));
            text.setAttribute("y", (rightPt.y + 4).toFixed(1));
            text.setAttribute("fill", major ? "rgba(255,255,255,0.80)" : "rgba(255,255,255,0.45)");
            text.setAttribute("font-size", major ? "11" : "10");
            text.setAttribute("font-family", "ui-monospace, 'Cascadia Code', monospace");
            text.setAttribute("font-weight", major ? "500" : "400");
            text.textContent = label;
            svg.appendChild(text);
        }
    }

    // Ensures camera matrices are current before projecting.
    function refreshAxisOverlay() {
        camera.updateProjectionMatrix();
        camera.updateMatrixWorld();
        updateAxisOverlay();
    }

    // Initial draw happens after the first render frame so matrices are warm.
    requestAnimationFrame(refreshAxisOverlay);

    // ─── Scrub Bar ────────────────────────────────────────────────────────────────

    const scrubBar      = document.getElementById("scrub-bar")!;
    const scrubInput    = document.getElementById("scrub-input") as HTMLInputElement;
    const scrubWindow   = document.getElementById("scrub-window")!;
    const scrubTimeLeft = document.getElementById("scrub-time-left")!;
    const scrubTimeRight= document.getElementById("scrub-time-right")!;
    const scrubTimeCurrent = document.getElementById("scrub-time-current")!;
    const btnLive       = document.getElementById("btn-live") as HTMLButtonElement;

    // Single source of truth: the "current slice" is an absolute index from recording start.
    // The scrub thumb's position represents this slice; the viewport extends LEFT from there.
    // During recording, "live" pins us to the most recent slice. During playback, this advances
    // automatically with audio time. While paused/scrubbing, the user controls it directly.

    function formatTimeSec(sec: number): string {
        if (!isFinite(sec) || sec < 0) sec = 0;
        const m = Math.floor(sec / 60).toString().padStart(2, "0");
        const s = Math.floor(sec % 60).toString().padStart(2, "0");
        return `${m}:${s}`;
    }

    function getRecordingDurationSec(): number {
        if (recordedDurationMs > 0) return recordedDurationMs / 1000;
        if (isRecording) return Math.max(0, (Date.now() - recordingStartTime) / 1000);
        return 0;
    }

    function getSlicesPerSec(): number {
        const sliceCount = recordedSlices > 0 ? recordedSlices : totalSlices;
        const dur = getRecordingDurationSec();
        if (sliceCount > 0 && dur > 0) return sliceCount / dur;
        return 60; // fallback estimate (60fps)
    }

    function getCurrentAbsoluteSlice(): number {
        if (isRecording && isLive) {
            return Math.max(0, totalSlices - 1);
        }
        if (isPlaying && audioCtx && recordedSlices > 0) {
            const elapsedSec = audioCtx.currentTime - playbackStartCtxTime;
            const sps = getSlicesPerSec();
            return Math.max(0, Math.min(recordedSlices - 1, Math.floor(playbackStartSlice + elapsedSec * sps)));
        }
        // Scrubbed / idle: read from the input. Convert scrubValue (0..available-1) to absolute.
        const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
        return oldestAvail + (parseInt(scrubInput.value) || 0);
    }

    function absoluteSliceToScrubValue(absSlice: number): number {
        const available = Math.min(totalSlices, MAX_HISTORY);
        if (available < 1) return 0;
        const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
        return Math.max(0, Math.min(available - 1, absSlice - oldestAvail));
    }

    function updateScrubBar(currentAbsSlice: number) {
        const available = Math.min(totalSlices, MAX_HISTORY);
        if (available < 1) return;

        scrubBar.classList.remove("hidden");

        const maxValue = available - 1;
        scrubInput.max = String(maxValue);

        // Sync thumb to current slice when recording-live or playing
        if ((isRecording && isLive) || isPlaying) {
            scrubInput.value = String(absoluteSliceToScrubValue(currentAbsSlice));
        }

        const scrubValue = parseInt(scrubInput.value) || 0;

        // Viewport window: TIME_SAMPLES wide, right edge at scrubValue
        const viewRight = scrubValue + 1; // exclusive
        const viewLeft = Math.max(0, viewRight - TIME_SAMPLES);
        const leftFrac = viewLeft / available;
        const widthFrac = (viewRight - viewLeft) / available;

        scrubWindow.style.left  = `${(leftFrac * 100).toFixed(2)}%`;
        scrubWindow.style.width = `${(widthFrac * 100).toFixed(2)}%`;

        // Time labels
        const sps = getSlicesPerSec();
        const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
        const newestAbs = Math.max(0, (recordedSlices > 0 ? recordedSlices : totalSlices) - 1);
        scrubTimeLeft.textContent = formatTimeSec(oldestAvail / sps);
        scrubTimeRight.textContent = formatTimeSec(newestAbs / sps);

        if (isPlaying) {
            scrubTimeCurrent.textContent = `▶ ${formatTimeSec(currentAbsSlice / sps)}`;
        } else if (isRecording && isLive) {
            scrubTimeCurrent.textContent = "● live";
        } else {
            scrubTimeCurrent.textContent = formatTimeSec(currentAbsSlice / sps);
        }
    }

    function goLive() {
        // "Live" means: jump to the newest slice. During recording, also re-pin tracking.
        isLive = true;
        if (isPlaying) stopPlayback();
        btnLive.classList.add("hidden");
        const available = Math.min(totalSlices, MAX_HISTORY);
        if (available > 0) {
            scrubInput.value = String(available - 1);
        }
        const cur = getCurrentAbsoluteSlice();
        renderViewport(cur);
        updateScrubBar(cur);
    }

    scrubInput.addEventListener("input", () => {
        isLive = false;
        btnLive.classList.remove("hidden");

        const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
        const newAbsSlice = oldestAvail + (parseInt(scrubInput.value) || 0);

        if (isPlaying && cachedAudioBuffer) {
            // Re-seek the audio (AudioBufferSourceNode can't be seeked in-place)
            startPlaybackFromSlice(newAbsSlice);
        } else {
            renderViewport(newAbsSlice);
            updateScrubBar(newAbsSlice);
        }
    });

    btnLive.addEventListener("click", goLive);

    // ─── Geometry Update ──────────────────────────────────────────────────────────

    // Render the mesh so its RIGHT edge corresponds to viewportRightAbsSlice.
    // Slices that fall outside available data (too old or future) are rendered as zeros.
    function renderViewport(viewportRightAbsSlice: number) {
        const stride = FREQ_SAMPLES + 1;
        const available = Math.min(totalSlices, MAX_HISTORY);
        const oldestAvailable = Math.max(0, totalSlices - MAX_HISTORY);
        const oldestRingIndex = (ringHead - available + MAX_HISTORY * 2) % MAX_HISTORY;

        for (let i = 0; i < TIME_SAMPLES; i++) {
            const destBase = i * stride;
            // i=0 is leftmost column, i=TIME_SAMPLES-1 is rightmost (most recent)
            const colAbs = viewportRightAbsSlice - (TIME_SAMPLES - 1 - i);

            if (colAbs < oldestAvailable || colAbs >= totalSlices) {
                heights.fill(0, destBase, destBase + FREQ_SAMPLES);
            } else {
                const slotInRing = colAbs - oldestAvailable;
                const ringSlice = (oldestRingIndex + slotInRing) % MAX_HISTORY;
                heights.set(
                    ringBuffer.subarray(ringSlice * FREQ_SAMPLES, ringSlice * FREQ_SAMPLES + FREQ_SAMPLES),
                    destBase,
                );
            }
        }

        // Apply temporal smoothing across columns when we're NOT live-recording.
        // During live capture the AnalyserNode already smooths data on the way INTO
        // the ring buffer (via smoothingTimeConstant), so re-applying here would
        // double-smooth. During playback/scrub we read raw recorded slices, so this
        // is where the smoothing slider takes effect.
        if (!(isRecording && isLive) && smoothing > 0) {
            const alpha = smoothing;
            const inv = 1 - alpha;
            for (let i = 1; i < TIME_SAMPLES; i++) {
                const curBase = i * stride;
                const prevBase = (i - 1) * stride;
                for (let j = 0; j < FREQ_SAMPLES; j++) {
                    heights[curBase + j] = (alpha * heights[prevBase + j] + inv * heights[curBase + j]) | 0;
                }
            }
        }

        geometry.setAttribute("displacement", new THREE.Uint8BufferAttribute(heights, 1));
        uniforms.uSensitivity.value = sensitivity;
    }

    function updateGeometry() {
        // Push new FFT frames ONLY during recording — never during playback (which would
        // corrupt the recorded history with a recomputed live FFT of the same audio).
        if (isRecording && analyser) {
            analyser.getByteFrequencyData(DATA);
            ringBuffer.set(DATA, ringHead * FREQ_SAMPLES);
            ringHead = (ringHead + 1) % MAX_HISTORY;
            totalSlices++;
        }

        const currentAbsSlice = getCurrentAbsoluteSlice();
        renderViewport(currentAbsSlice);

        if (totalSlices > 0) {
            updateScrubBar(currentAbsSlice);
        }
    }

    // ─── Animation Loop ───────────────────────────────────────────────────────────

    function animate() {
        requestAnimationFrame(animate);
        updateGeometry();
        renderer.render(scene, camera);
    }

    animate();

    // ─── Window Resize ────────────────────────────────────────────────────────────

    window.addEventListener("resize", () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        refreshAxisOverlay();
    });

    // ─── Audio Setup ──────────────────────────────────────────────────────────────

    async function getAudioDevices() {
        try {
            // Request permission first so we can enumerate labeled devices
            const tempStream = await navigator.mediaDevices.getUserMedia({ audio: true });
            tempStream.getTracks().forEach((t) => t.stop());

            const devices = await navigator.mediaDevices.enumerateDevices();
            const micSelect = document.getElementById("mic-select") as HTMLSelectElement;
            micSelect.innerHTML = "";

            devices
                .filter((d) => d.kind === "audioinput")
                .forEach((d, i) => {
                    const opt = document.createElement("option");
                    opt.value = d.deviceId;
                    opt.textContent = d.label || `Microphone ${i + 1}`;
                    micSelect.appendChild(opt);
                });
        } catch {
            // Permissions not granted yet — will ask on Record
        }
    }

    async function startRecording() {
        const micSelect = document.getElementById("mic-select") as HTMLSelectElement;
        const deviceId = micSelect.value;

        try {
            const constraints: MediaStreamConstraints = {
                audio: {
                    echoCancellation: false,
                    noiseSuppression: false,
                    autoGainControl: false,
                    ...(deviceId ? { deviceId: { exact: deviceId } } : {}),
                },
            };

            micStream = await navigator.mediaDevices.getUserMedia(constraints);

            // Reset ring buffer + playback caches for the new session
            ringBuffer.fill(0);
            ringHead           = 0;
            totalSlices        = 0;
            recordedSlices     = 0;
            recordedDurationMs = 0;
            cachedAudioBuffer  = null;
            isLive             = true;
            btnLive.classList.add("hidden");
            scrubBar.classList.add("hidden");
            scrubInput.value = "0";

            audioCtx = new AudioContext();
            sampleRate = audioCtx.sampleRate; // lock tick positions to actual hardware rate
            analyser = audioCtx.createAnalyser();
            analyser.fftSize = 4 * FREQ_SAMPLES;
            smoothing = parseFloat(
                (document.getElementById("smoothing") as HTMLInputElement).value
            );
            analyser.smoothingTimeConstant = smoothing;

            micSource = audioCtx.createMediaStreamSource(micStream);
            micSource.connect(analyser);

            // MediaRecorder for saving audio
            recordedChunks = [];
            const mimeType = MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
                ? "audio/webm;codecs=opus"
                : "audio/webm";
            mediaRecorder = new MediaRecorder(micStream, { mimeType });
            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) recordedChunks.push(e.data);
            };
            mediaRecorder.onstop = () => {
                recordedBlob = new Blob(recordedChunks, { type: mimeType });
                setButtonState("stopped");
            };
            mediaRecorder.start(250);

            isRecording = true;
            recordingStartTime = Date.now();
            startDurationTimer();
            setButtonState("recording");

            // Refresh device list and axis ticks now that we have real sample rate
            getAudioDevices();
            refreshAxisOverlay();
        } catch (err) {
            console.error("Microphone error:", err);
            document.getElementById("no-mic-alert")!.classList.remove("hidden");
        }
    }

    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state !== "inactive") {
            mediaRecorder.stop();
        }
        if (micSource) {
            micSource.disconnect();
            micSource = null;
        }
        if (micStream) {
            micStream.getTracks().forEach((t) => t.stop());
            micStream = null;
        }
        analyser = null;
        isRecording = false;

        // Snapshot the recording for playback math
        recordedSlices = totalSlices;
        recordedDurationMs = Math.max(1, Date.now() - recordingStartTime);
        cachedAudioBuffer = null; // force re-decode on first play

        stopDurationTimer();
    }

    // Internal: (re)start audio playback from a specific absolute slice index.
    // Used by Play, scrub-while-playing, and arrow-key seeks during playback.
    function startPlaybackFromSlice(absSlice: number) {
        if (!audioCtx || !cachedAudioBuffer || recordedSlices < 1) return;

        // Tear down any existing source
        if (playbackSource) {
            try {
                playbackSource.onended = null;
                playbackSource.stop();
            } catch {}
            try { playbackSource.disconnect(); } catch {}
            playbackSource = null;
        }

        const sps = getSlicesPerSec();
        const startTimeSec = Math.max(0, Math.min(cachedAudioBuffer.duration, absSlice / sps));

        playbackSource = audioCtx.createBufferSource();
        playbackSource.buffer = cachedAudioBuffer;
        playbackSource.connect(audioCtx.destination);

        playbackStartCtxTime = audioCtx.currentTime;
        playbackStartSlice = absSlice;

        const localSource = playbackSource;
        playbackSource.onended = () => {
            // Ignore the onended that fires from our own stop() during a re-seek
            if (localSource !== playbackSource) return;
            isPlaying = false;
            stopDurationTimer();
            setButtonState("stopped");
        };

        playbackSource.start(0, startTimeSec);

        isPlaying = true;
        isLive = false;
        btnLive.classList.remove("hidden");
        setButtonState("playing");
    }

    async function playRecording() {
        if (!recordedBlob) return;
        if (!audioCtx) audioCtx = new AudioContext();

        if (!cachedAudioBuffer) {
            const arrayBuffer = await recordedBlob.arrayBuffer();
            cachedAudioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
            // Refine duration with the precise decoded value
            recordedDurationMs = Math.max(recordedDurationMs, cachedAudioBuffer.duration * 1000);
        }

        // Determine where to start: current scrub position, but jump to the beginning
        // if the thumb is at the end (or in live mode) so Play always plays SOMETHING.
        const available = Math.min(totalSlices, MAX_HISTORY);
        const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
        const maxValue = Math.max(0, available - 1);
        const scrubValue = parseInt(scrubInput.value) || 0;

        let startSlice = oldestAvail + scrubValue;
        if (isLive || scrubValue >= maxValue - 1) {
            startSlice = oldestAvail;
        }

        startPlaybackFromSlice(startSlice);
        startDurationTimer();
    }

    function stopPlayback() {
        if (playbackSource) {
            try {
                playbackSource.onended = null;
                playbackSource.stop();
            } catch {}
            try { playbackSource.disconnect(); } catch {}
            playbackSource = null;
        }
        isPlaying = false;
        stopDurationTimer();
        setButtonState("stopped");
    }

    function downloadRecording() {
        if (!recordedBlob) return;
        const url = URL.createObjectURL(recordedBlob);
        const a = document.createElement("a");
        a.href = url;
        const ts = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
        a.download = `cnc-recording-${ts}.webm`;
        a.click();
        URL.revokeObjectURL(url);
    }

    // ─── UI State Management ──────────────────────────────────────────────────────

    type AppState = "idle" | "recording" | "stopped" | "playing";

    function setButtonState(state: AppState) {
        const btnRecord = document.getElementById("btn-record") as HTMLButtonElement;
        const btnStop = document.getElementById("btn-stop") as HTMLButtonElement;
        const btnPlay = document.getElementById("btn-play") as HTMLButtonElement;
        const btnDownload = document.getElementById("btn-download") as HTMLButtonElement;
        const statusBadge = document.getElementById("status-badge")!;
        const statusDot = document.getElementById("status-dot")!;
        const statusText = document.getElementById("status-text")!;
        const durationDisplay = document.getElementById("duration-display")!;

        // Reset classes
        statusDot.className = "w-1.5 h-1.5 rounded-full inline-block";
        statusBadge.className = "badge-secondary flex items-center gap-1.5";

        if (state === "idle") {
            btnRecord.disabled = false;
            btnStop.disabled = true;
            btnPlay.disabled = true;
            btnDownload.disabled = true;
            statusText.textContent = "Idle";
            statusDot.classList.add("bg-gray-400");
            durationDisplay.classList.add("hidden");
        } else if (state === "recording") {
            btnRecord.disabled = true;
            btnStop.disabled = false;
            btnPlay.disabled = true;
            btnDownload.disabled = true;
            statusBadge.className = "badge-error flex items-center gap-1.5";
            statusText.textContent = "Recording";
            statusDot.classList.add("recording-dot");
            durationDisplay.classList.remove("hidden");
        } else if (state === "stopped") {
            btnRecord.disabled = false;
            btnStop.disabled = true;
            btnPlay.disabled = false;
            btnDownload.disabled = false;
            statusBadge.className = "badge-secondary flex items-center gap-1.5";
            statusText.textContent = "Ready";
            statusDot.classList.add("bg-gray-400");
            durationDisplay.classList.remove("hidden");
        } else if (state === "playing") {
            btnRecord.disabled = true;
            btnStop.disabled = false;
            btnPlay.disabled = true;
            btnDownload.disabled = false;
            statusBadge.className = "badge-success flex items-center gap-1.5";
            statusText.textContent = "Playing";
            statusDot.classList.add("playing-dot");
            durationDisplay.classList.remove("hidden");
        }
    }

    // ─── Duration Timer ───────────────────────────────────────────────────────────

    function startDurationTimer() {
        stopDurationTimer();
        recordingStartTime = Date.now();
        durationTimer = setInterval(updateDurationDisplay, 100);
    }

    function stopDurationTimer() {
        if (durationTimer) {
            clearInterval(durationTimer);
            durationTimer = null;
        }
    }

    function updateDurationDisplay() {
        const elapsed = (Date.now() - recordingStartTime) / 1000;
        const mins = Math.floor(elapsed / 60).toString().padStart(2, "0");
        const secs = (elapsed % 60).toFixed(1).padStart(4, "0");
        const el = document.getElementById("duration-display");
        if (el) el.textContent = `${mins}:${secs}`;
    }

    // ─── Event Listeners ──────────────────────────────────────────────────────────

    document.getElementById("btn-record")!.addEventListener("click", () => {
        if (isPlaying) stopPlayback();
        startRecording();
    });

    document.getElementById("btn-stop")!.addEventListener("click", () => {
        if (isRecording) stopRecording();
        else if (isPlaying) stopPlayback();
    });

    document.getElementById("btn-play")!.addEventListener("click", () => {
        playRecording();
    });

    document.getElementById("btn-download")!.addEventListener("click", downloadRecording);

    const sensitivityInput = document.getElementById("sensitivity") as HTMLInputElement;

    function setSensitivity(val: number) {
        const clamped = Math.max(0.1, Math.min(20, parseFloat(val.toFixed(1))));
        sensitivity = clamped;
        sensitivityInput.value = clamped.toString();
    }

    sensitivityInput.addEventListener("input", () => {
        const v = parseFloat(sensitivityInput.value);
        if (!isNaN(v)) setSensitivity(v);
    });

    document.getElementById("sensitivity-dec")!.addEventListener("click", () => {
        setSensitivity(sensitivity - 0.1);
    });

    document.getElementById("sensitivity-inc")!.addEventListener("click", () => {
        setSensitivity(sensitivity + 0.1);
    });

    // Keyboard shortcuts: [ / ] sensitivity, ← / → scrub, End = live
    document.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

        if (e.key === "[") {
            e.preventDefault();
            setSensitivity(sensitivity - 0.1);
        } else if (e.key === "]") {
            e.preventDefault();
            setSensitivity(sensitivity + 0.1);
        } else if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
            e.preventDefault();
            const available = Math.min(totalSlices, MAX_HISTORY);
            if (available < 1) return;

            const step = Math.round(getSlicesPerSec()); // ~1 second
            const maxValue = available - 1;
            const current = parseInt(scrubInput.value) || 0;
            const next = e.key === "ArrowLeft"
                ? Math.max(0, current - step)
                : Math.min(maxValue, current + step);

            isLive = false;
            btnLive.classList.remove("hidden");
            scrubInput.value = String(next);

            const oldestAvail = Math.max(0, totalSlices - MAX_HISTORY);
            const newAbsSlice = oldestAvail + next;

            if (isPlaying && cachedAudioBuffer) {
                startPlaybackFromSlice(newAbsSlice);
            } else {
                renderViewport(newAbsSlice);
                updateScrubBar(newAbsSlice);
            }
        } else if (e.key === "End") {
            e.preventDefault();
            goLive();
        }
    });

    document.getElementById("smoothing")!.addEventListener("input", (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        smoothing = val;
        if (analyser) analyser.smoothingTimeConstant = val;
    });

    document.getElementById("camera-angle")!.addEventListener("input", (e) => {
        cameraAngle = parseInt((e.target as HTMLInputElement).value);
        updateCamera(cameraAngle);
        refreshAxisOverlay();
    });

    // ─── Init ─────────────────────────────────────────────────────────────────────

    setButtonState("idle");
    getAudioDevices();
</script>
