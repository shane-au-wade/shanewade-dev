---
// Design System Showcase
import Modal from "@components/modal.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
import Head from "@components/head.astro";
import ThemeToggle from "@components/theme-toggle.astro";
import Code from "@components/code.astro";

import AsciiStyleNav from "@components/ascii-style-nav.astro";
import MobileFloatingCollapse from "@components/mobile-floating-collapse.astro";

import "@styles/components.css";
import "remixicon/fonts/remixicon.css";
---

<html lang="en">
    <Head title="Design System - Shane Wade" />
    <body
        class="bg-page dark:bg-dark-bg min-h-screen transition-colors duration-300"
    >
        <!-- Header with Dark Mode Toggle -->
        <header
            class="sticky top-0 z-50 bg-white dark:bg-dark-bg-elevated border-b border-gray-200 dark:border-dark-border backdrop-blur-sm bg-opacity-90 dark:bg-opacity-90"
        >
            <div class="container py-2 flex items-center justify-between">
                <div>
                    <Breadcrumbs />
                    <p class="text-lead">Component library & style guide</p>
                </div>
            </div>
        </header>

        <div class="container">
            <MobileFloatingCollapse>
                <AsciiStyleNav
                    items={[
                        { label: "Colors", href: "#colors", icon: "" },
                        { label: "Typography", href: "#typography", icon: "" },
                        { label: "Buttons", href: "#buttons", icon: "" },
                        { label: "Forms", href: "#forms", icon: "" },
                        { label: "Checkboxes", href: "#checkboxes", icon: "" },
                        { label: "Cards", href: "#cards", icon: "" },
                        { label: "Badges", href: "#badges", icon: "" },
                        { label: "Alerts", href: "#alerts", icon: "" },
                        { label: "Modal", href: "#modal", icon: "" },
                        {
                            label: "Code Blocks",
                            href: "#code-blocks",
                            icon: "",
                        },
                        {
                            label: "Breadcrumbs",
                            href: "#breadcrumbs",
                            icon: "",
                        },
                        { label: "Layouts", href: "#layouts", icon: "" },
                    ]}
                />
                <ThemeToggle />
            </MobileFloatingCollapse>

            <!-- Colors Section -->
            <section id="colors" class="section">
                <h2 class="heading-2 mb-6">Colors</h2>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Brand Colors</h3>
                    <div class="flex flex-wrap gap-4">
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-brand-primary rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Primary</p>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >#89181e</code
                            >
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-brand-primary-hover rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Hover</p>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >#a83a2e</code
                            >
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-brand-primary-dark rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Dark</p>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >#55161c</code
                            >
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-brand-primary-light rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Light</p>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >#e05545</code
                            >
                        </div>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Neutral Colors</h3>
                    <div class="flex flex-wrap gap-4">
                        <div class="text-center">
                            <div
                                class="w-16 h-16 bg-gray-100 rounded-lg border border-gray-300 dark:border-dark-border mb-2"
                            >
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-100</code
                            >
                        </div>
                        <div class="text-center">
                            <div
                                class="w-16 h-16 bg-gray-200 rounded-lg border border-gray-300 dark:border-dark-border mb-2"
                            >
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-200</code
                            >
                        </div>
                        <div class="text-center">
                            <div class="w-16 h-16 bg-gray-300 rounded-lg mb-2">
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-300</code
                            >
                        </div>
                        <div class="text-center">
                            <div class="w-16 h-16 bg-gray-400 rounded-lg mb-2">
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-400</code
                            >
                        </div>
                        <div class="text-center">
                            <div class="w-16 h-16 bg-gray-500 rounded-lg mb-2">
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-500</code
                            >
                        </div>
                        <div class="text-center">
                            <div class="w-16 h-16 bg-gray-600 rounded-lg mb-2">
                            </div>
                            <code
                                class="text-xs text-gray-400 dark:text-dark-text-muted"
                                >gray-600</code
                            >
                        </div>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Semantic Colors</h3>
                    <div class="flex flex-wrap gap-4">
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-success rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Success</p>
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-warning rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Warning</p>
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-error rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Error</p>
                        </div>
                        <div class="text-center">
                            <div
                                class="w-24 h-24 bg-info rounded-lg shadow-md mb-2"
                            >
                            </div>
                            <p class="text-small">Info</p>
                        </div>
                    </div>
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Typography Section -->
            <section id="typography" class="section">
                <h2 class="heading-2 mb-6">Typography</h2>

                <div class="space-y-6">
                    <div>
                        <h1 class="heading-1">Heading 1</h1>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-1"</code
                        >
                    </div>
                    <div>
                        <h2 class="heading-2">Heading 2</h2>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-2"</code
                        >
                    </div>
                    <div>
                        <h3 class="heading-3">Heading 3</h3>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-3"</code
                        >
                    </div>
                    <div>
                        <h4 class="heading-4">Heading 4</h4>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-4"</code
                        >
                    </div>
                    <div>
                        <h5 class="heading-5">Heading 5</h5>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-5"</code
                        >
                    </div>
                    <div>
                        <h6 class="heading-6">Heading 6</h6>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="heading-6"</code
                        >
                    </div>
                    <div>
                        <p class="text-lead">
                            Lead text - perfect for introductions and important
                            content that needs to stand out.
                        </p>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="text-lead"</code
                        >
                    </div>
                    <div>
                        <p class="text-body">
                            Body text - the default paragraph text used
                            throughout the site for regular content.
                        </p>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="text-body"</code
                        >
                    </div>
                    <div>
                        <p class="text-small">
                            Small text - useful for secondary information and
                            captions.
                        </p>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="text-small"</code
                        >
                    </div>
                    <div>
                        <p class="text-muted">
                            Muted text - for less important information.
                        </p>
                        <code
                            class="text-xs text-gray-400 dark:text-dark-text-muted"
                            >class="text-muted"</code
                        >
                    </div>
                    <div>
                        <a href="#" class="link">Link with underline</a> |
                        <a href="#" class="link-subtle">Subtle link</a>
                    </div>
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Buttons Section -->
            <section id="buttons" class="section">
                <h2 class="heading-2 mb-6">Buttons</h2>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Variants</h3>
                    <div class="flex flex-wrap gap-3">
                        <button class="btn">Base</button>
                        <button class="btn-primary">Primary</button>
                        <button class="btn-secondary">Secondary</button>
                        <button class="btn-default">Default</button>
                        <button class="btn-outline">Outline</button>
                        <button class="btn-ghost">Ghost</button>
                        <button class="btn-ghost-primary">Ghost Primary</button>
                        <button class="btn-disabled">Disabled</button>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Semantic</h3>
                    <div class="flex flex-wrap gap-3">
                        <button class="btn-success">Success</button>
                        <button class="btn-warning">Warning</button>
                        <button class="btn-error">Error</button>
                        <button class="btn-info">Info</button>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Sizes</h3>
                    <div class="flex flex-wrap items-center gap-3">
                        <button class="btn-primary btn-sm">Small</button>
                        <button class="btn-primary">Default</button>
                        <button class="btn-primary btn-lg">Large</button>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">With Icons</h3>
                    <div class="flex flex-wrap gap-3">
                        <button class="btn-primary">
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v16m8-8H4"></path>
                            </svg>
                            Add Item
                        </button>
                        <button class="btn-outline">
                            Download
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                ></path>
                            </svg>
                        </button>
                        <button
                            class="btn-default btn-icon"
                            aria-label="Settings"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Forms Section -->
            <section id="forms" class="section">
                <h2 class="heading-2 mb-6">Forms</h2>

                <div class="card max-w-2xl">
                    <div class="card-body space-y-6">
                        <div>
                            <label for="text-input" class="label"
                                >Text Input</label
                            >
                            <input
                                type="text"
                                id="text-input"
                                class="input"
                                placeholder="Enter text..."
                            />
                            <p class="help-text">
                                This is helper text for the input field.
                            </p>
                        </div>

                        <div>
                            <label for="email-input" class="label">Email</label>
                            <input
                                type="email"
                                id="email-input"
                                class="input"
                                placeholder="you@example.com"
                            />
                        </div>

                        <div>
                            <label for="password-input" class="label"
                                >Password</label
                            >
                            <input
                                type="password"
                                id="password-input"
                                class="input input-error"
                                placeholder="••••••••"
                            />
                            <p class="error-text">
                                Password must be at least 8 characters.
                            </p>
                        </div>

                        <div>
                            <label for="select-input" class="label"
                                >Select</label
                            >
                            <select id="select-input" class="select">
                                <option>Choose an option...</option>
                                <option>Option 1</option>
                                <option>Option 2</option>
                                <option>Option 3</option>
                            </select>
                        </div>

                        <div>
                            <label for="textarea-input" class="label"
                                >Textarea</label
                            >
                            <textarea
                                id="textarea-input"
                                class="textarea"
                                placeholder="Enter your message..."></textarea>
                        </div>

                        <div class="space-y-3">
                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="check1"
                                    class="checkbox"
                                />
                                <label
                                    for="check1"
                                    class="label-inline cursor-pointer"
                                    >I agree to the terms</label
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="check2"
                                    class="checkbox"
                                    checked
                                />
                                <label
                                    for="check2"
                                    class="label-inline cursor-pointer"
                                    >Send me updates</label
                                >
                            </div>
                        </div>

                        <div class="space-y-3">
                            <p class="label">Choose a size:</p>
                            <div class="flex items-center gap-2">
                                <input
                                    type="radio"
                                    id="radio1"
                                    name="size"
                                    class="radio"
                                />
                                <label
                                    for="radio1"
                                    class="label-inline cursor-pointer"
                                    >Small</label
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <input
                                    type="radio"
                                    id="radio2"
                                    name="size"
                                    class="radio"
                                    checked
                                />
                                <label
                                    for="radio2"
                                    class="label-inline cursor-pointer"
                                    >Medium</label
                                >
                            </div>
                            <div class="flex items-center gap-2">
                                <input
                                    type="radio"
                                    id="radio3"
                                    name="size"
                                    class="radio"
                                />
                                <label
                                    for="radio3"
                                    class="label-inline cursor-pointer"
                                    >Large</label
                                >
                            </div>
                        </div>

                        <div>
                            <label class="label">Input with Button</label>
                            <div class="input-group">
                                <input
                                    type="email"
                                    class="input"
                                    placeholder="Enter your email"
                                />
                                <button class="btn-primary">Subscribe</button>
                            </div>
                        </div>

                        <div class="flex gap-3">
                            <button class="btn-primary">Submit</button>
                            <button class="btn-default">Cancel</button>
                        </div>
                    </div>
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Checkboxes Section -->
            <section id="checkboxes" class="section">
                <h2 class="heading-2 mb-6">Checkboxes</h2>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Checkbox States</h3>
                    <div class="card max-w-2xl">
                        <div class="card-body space-y-4">
                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="checkbox-unchecked"
                                    class="checkbox"
                                />
                                <label
                                    for="checkbox-unchecked"
                                    class="label-inline cursor-pointer"
                                    >Unchecked</label
                                >
                            </div>

                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="checkbox-checked"
                                    class="checkbox"
                                    checked
                                />
                                <label
                                    for="checkbox-checked"
                                    class="label-inline cursor-pointer"
                                    >Checked</label
                                >
                            </div>

                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="checkbox-disabled"
                                    class="checkbox"
                                    disabled
                                />
                                <label
                                    for="checkbox-disabled"
                                    class="label-inline opacity-50"
                                    >Disabled (unchecked)</label
                                >
                            </div>

                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="checkbox-disabled-checked"
                                    class="checkbox"
                                    checked
                                    disabled
                                />
                                <label
                                    for="checkbox-disabled-checked"
                                    class="label-inline opacity-50"
                                    >Disabled (checked)</label
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-8">
                    <h3 class="heading-5 mb-4">Usage Example</h3>
                    <div class="card max-w-2xl">
                        <div class="card-header">
                            <h4 class="heading-6">Notification Preferences</h4>
                        </div>
                        <div class="card-body space-y-3">
                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="notif-email"
                                    class="checkbox"
                                    checked
                                />
                                <label
                                    for="notif-email"
                                    class="label-inline cursor-pointer"
                                >
                                    <span class="font-medium"
                                        >Email notifications</span
                                    >
                                    <span class="block text-small text-muted"
                                        >Receive updates via email</span
                                    >
                                </label>
                            </div>

                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="notif-push"
                                    class="checkbox"
                                    checked
                                />
                                <label
                                    for="notif-push"
                                    class="label-inline cursor-pointer"
                                >
                                    <span class="font-medium"
                                        >Push notifications</span
                                    >
                                    <span class="block text-small text-muted"
                                        >Receive push notifications on your
                                        device</span
                                    >
                                </label>
                            </div>

                            <div class="flex items-center gap-2">
                                <input
                                    type="checkbox"
                                    id="notif-sms"
                                    class="checkbox"
                                />
                                <label
                                    for="notif-sms"
                                    class="label-inline cursor-pointer"
                                >
                                    <span class="font-medium"
                                        >SMS notifications</span
                                    >
                                    <span class="block text-small text-muted"
                                        >Receive text messages for important
                                        updates</span
                                    >
                                </label>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button class="btn-primary btn-sm"
                                >Save Preferences</button
                            >
                        </div>
                    </div>
                </div>

                <div class="mb-8 max-w-2xl">
                    <h3 class="heading-5 mb-4">Code Example</h3>
                    <Code
                        code={`
<div class="flex items-center gap-2">
  <input
    type="checkbox"
    id="my-checkbox"
    class="checkbox"
  />
  <label
    for="my-checkbox"
    class="label-inline cursor-pointer"
  >
    Label text
  </label>
</div>`.trim()}
                        lang="html"
                        wrap
                    />
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Cards Section -->
            <section id="cards" class="section">
                <h2 class="heading-2 mb-6">Cards</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="heading-5 mb-2">Simple Card</h3>
                            <p class="text-body">
                                This is a basic card with just body content.
                                Perfect for simple content blocks.
                            </p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="heading-5">Card with Header</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-body">
                                This card has a header section separated from
                                the body content.
                            </p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="heading-5">Full Card</h3>
                        </div>
                        <div class="card-body">
                            <p class="text-body">
                                This card has all three sections: header, body,
                                and footer.
                            </p>
                        </div>
                        <div class="card-footer">
                            <div class="flex gap-2">
                                <button class="btn-primary btn-sm"
                                    >Action</button
                                >
                                <button class="btn-default btn-sm"
                                    >Cancel</button
                                >
                            </div>
                        </div>
                    </div>

                    <div class="card-hover">
                        <div class="card-body">
                            <h3 class="heading-5 mb-2">Hoverable Card</h3>
                            <p class="text-body">
                                This card has a hover effect for interactive
                                content.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <div class="divider my-12"></div>

            <!-- Badges Section -->
            <section id="badges" class="section">
                <h2 class="heading-2 mb-6">Badges</h2>

                <div class="mb-8">
