---
import { supabase } from "../../lib/db/supabase-client";
import {
    getRecipe,
    getGroceryListFromRecipes,
    type Recipe,
} from "@lib/recipes/queries";
import RecipesModal from "@components/recipes-modal.astro";
import Head from "@components/head.astro";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

// Check for recipe IDs in URL params
const url = new URL(Astro.request.url);
const recipesParam = url.searchParams.get("recipes");

const DEBUG = url.searchParams.get("debug") === "true";

let groceryListData: Record<string, string> = {};
let recipeCount = 0;
let errorMessage = "";
let recipes: Recipe[] = [];

if (recipesParam) {
    // Parse recipe IDs from URL
    const recipeIds = recipesParam
        .split(",")
        .map((id) => id.trim())
        .filter(Boolean);
    recipeCount = recipeIds.length;

    if (recipeIds.length > 0) {
        try {
            // Fetch all recipes
            const recipePromises = recipeIds.map((id) =>
                getRecipe(supabase, id),
            );
            recipes = await Promise.all(recipePromises);

            // Generate grocery list from recipes
            groceryListData = getGroceryListFromRecipes(recipes);
        } catch (error) {
            console.error("Error fetching recipes:", error);
            errorMessage =
                error instanceof Error
                    ? error.message
                    : "Failed to fetch recipes";
        }
    }
}

// Separate "as needed" items from quantified items
const asNeededGroceries: Record<string, string> = {};
const groceries: Record<string, string> = {};
Object.entries(groceryListData).forEach(([key, value]) => {
    if (value.toLowerCase().includes("as needed")) {
        asNeededGroceries[key] = value;
        return;
    }
    groceries[key] = value;
});

// Sort items alphabetically
const sortedGroceries = Object.entries(groceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const sortedAsNeededGroceries = Object.entries(asNeededGroceries).sort((a, b) =>
    a[0].localeCompare(b[0]),
);

const totalItems = sortedGroceries.length + sortedAsNeededGroceries.length;
---

<style>
    .grocery-item.checked {
        opacity: 0.5;
    }

    .grocery-item.checked .item-name,
    .grocery-item.checked .item-quantity {
        text-decoration: line-through;
    }

    /* Flash animation for remote updates */
    @keyframes flash {
        0%,
        100% {
            background-color: transparent;
        }
        50% {
            background-color: rgba(196, 69, 54, 0.1);
        }
    }

    .grocery-item.flash {
        animation: flash 0.6s ease-in-out;
    }

    /* Connection status indicator */
    .connection-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }

    .connection-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .connection-dot.connected {
        background-color: #10b981;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    }

    .connection-dot.disconnected {
        background-color: #6b7280;
    }
</style>

<html lang="en">
    <Head title="Grocery List" />
    <body class="bg-page dark:bg-dark-bg min-h-screen">
        <div class="container py-4 max-w-2xl">
            <nav class="mb-4">
                <a href="/recipes/composer" class="link-subtle text-sm">
                    <i class="ri-add-line"></i> New Grocery List
                </a>
            </nav>
            <div class="card mb-4">
                <div class="card-body">
                    <h1 class="heading-2 mb-2">Grocery List</h1>
                    {
                        recipeCount > 0 && (
                            <p class="text-muted mb-4">
                                {/* do not adjust this line  */}
                                From {recipeCount} recipe
                                {recipeCount !== 1 ? "s" : ""}
                            </p>
                        )
                    }
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-body font-semibold" id="checked-count"
                            >0</span
                        >
                        <span class="text-body">/</span>
                        <span class="text-body">{totalItems}</span>
                        <span class="text-small text-muted">items checked</span>
                    </div>
                    <div class="flex flex-wrap gap-2 items-center">
                        {
                            DEBUG && (
                                <section>
                                    <button
                                        class="btn-default btn-sm"
                                        id="clear-checked"
                                    >
                                        Clear Checked
                                    </button>
                                    <button
                                        class="btn-default btn-sm"
                                        id="reset-all"
                                    >
                                        Reset All
                                    </button>
                                </section>
                            )
                        }

                        {
                            recipes.length > 0 && (
                                <button
                                    class="btn-primary btn-sm"
                                    onclick="window.openRecipesModal('recipes-modal')"
                                >
                                    View Recipes ({recipes.length})
                                </button>
                            )
                        }

                        {
                            totalItems > 0 && (
                                <>
                                    <button
                                        class="btn-secondary btn-sm"
                                        id="share-list-btn"
                                    >
                                        <i class="ri-share-line" /> Share List
                                    </button>
                                    <button
                                        class="btn-outline btn-sm hidden"
                                        id="copy-url-btn"
                                    >
                                        <i class="ri-clipboard-line" /> Copy URL
                                    </button>
                                    <span
                                        class="connection-status hidden"
                                        id="connection-status"
                                    >
                                        <span class="connection-dot disconnected" />
                                        <span class="text-muted">
                                            Connecting...
                                        </span>
                                    </span>
                                </>
                            )
                        }
                    </div>
                </div>
            </div>

            {
                errorMessage && (
                    <div class="alert-error mb-4">
                        <strong>Error:</strong> {errorMessage}
                    </div>
                )
            }

            {
                sortedGroceries.length === 0 &&
                sortedAsNeededGroceries.length === 0 ? (
                    <div class="card">
                        <div class="card-body text-center py-12">
                            <div class="text-6xl mb-4">🛒</div>
                            {recipesParam ? (
                                <p class="text-muted">
                                    No ingredients found in selected recipes
                                </p>
                            ) : (
                                <div>
                                    <p class="text-muted mb-4">
                                        No recipes selected
                                    </p>
                                    <a
                                        href="/recipes/composer"
                                        class="btn-primary"
                                    >
                                        Select Recipes
                                    </a>
                                </div>
                            )}
                        </div>
                    </div>
                ) : (
                    <>
                        <div class="card overflow-hidden">
                            {sortedGroceries.map(([name, quantity]) => (
                                <div class="grocery-item flex items-center px-4 py-3 border-b border-gray-200 dark:border-dark-border last:border-b-0 hover:bg-gray-50 dark:hover:bg-dark-bg transition-colors">
                                    <div class="relative mr-3 flex-shrink-0">
                                        <input
                                            type="checkbox"
                                            class="checkbox grocery-item-checkbox"
                                            id={`item-${name}`}
                                            data-item={name}
                                        />
                                    </div>
                                    <label
                                        for={`item-${name}`}
                                        class="flex-1 flex items-center justify-between gap-4 cursor-pointer"
                                    >
                                        <span class="item-name text-body font-medium">
                                            {name}
                                        </span>
                                        <span class="item-quantity text-small text-muted whitespace-nowrap">
                                            {quantity}
                                        </span>
                                    </label>
                                </div>
                            ))}
                        </div>

                        {sortedAsNeededGroceries.length > 0 && (
                            <>
                                <div class="mt-6 mb-2">
                                    <h3 class="text-small font-semibold text-muted uppercase tracking-wide">
                                        Pantry Staples
                                    </h3>
                                </div>
                                <div class="card overflow-hidden">
                                    {sortedAsNeededGroceries.map(
                                        ([name, quantity]) => (
                                            <div class="grocery-item flex items-center px-4 py-3 border-b border-gray-200 dark:border-dark-border last:border-b-0 hover:bg-gray-50 dark:hover:bg-dark-bg transition-colors">
                                                <div class="relative mr-3 flex-shrink-0">
                                                    <input
                                                        type="checkbox"
                                                        class="checkbox grocery-item-checkbox"
                                                        id={`item-${name}`}
                                                        data-item={name}
                                                    />
                                                </div>
                                                <label
                                                    for={`item-${name}`}
                                                    class="flex-1 flex items-center justify-between gap-4 cursor-pointer"
                                                >
                                                    <span class="item-name text-body font-medium">
                                                        {name}
                                                    </span>
                                                    <span class="item-quantity text-small text-muted whitespace-nowrap">
                                                        {quantity}
                                                    </span>
                                                </label>
                                            </div>
                                        ),
                                    )}
                                </div>
                            </>
                        )}
                    </>
                )
            }
        </div>

        <RecipesModal recipes={recipes} modalId="recipes-modal" />
    </body>
</html>

<script>
    // @ts-nocheck
    import { supabaseBrowser } from "../../lib/db/supabase-browser-client";

    const url = new URL(window.location.href);
    const recipesParam = url.searchParams.get("recipes");
    const sessionParam = url.searchParams.get("session");

    // Generate unique client ID for this browser tab
    const clientId = `client-${Math.random().toString(36).substring(2, 9)}`;

    // Local storage key - unique per recipe combination
    const STORAGE_KEY = recipesParam
        ? `grocery-list-checked-${recipesParam}`
        : "grocery-list-checked";

    // Global state
    let realtimeChannel = null;
    let checkedItems = new Set();

    // Load checked items from localStorage
    function loadCheckedItems() {
        try {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored ? new Set(JSON.parse(stored)) : new Set();
        } catch (e) {
            console.error("Failed to load checked items:", e);
            return new Set();
        }
    }

    // Save checked items to localStorage
    function saveCheckedItems(items) {
        try {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(Array.from(items)),
            );
        } catch (e) {
            console.error("Failed to save checked items:", e);
        }
    }

    // Update the checked count display
    function updateCheckedCount(count) {
        const countElement = document.getElementById("checked-count");
        if (countElement) {
            countElement.textContent = count.toString();
        }
    }

    // Update connection status UI
    function updateConnectionStatus(status, message) {
        const statusElement = document.getElementById("connection-status");
        if (!statusElement) return;

        const dot = statusElement.querySelector(".connection-dot");
        const text = statusElement.querySelector(".text-muted");

        if (status === "connected") {
            dot.classList.remove("disconnected");
            dot.classList.add("connected");
            text.textContent = message || "Connected";
            text.classList.remove("text-muted");
            text.classList.add("text-success");
        } else if (status === "disconnected") {
            dot.classList.remove("connected");
            dot.classList.add("disconnected");
            text.textContent = message || "Disconnected";
            text.classList.remove("text-success");
            text.classList.add("text-muted");
        }
    }

    // Generate session ID and update URL
    function generateSession() {
        // Generate a 8 character session ID
        const sessionId = crypto.randomUUID().slice(0, 8);
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set("session", sessionId);
        window.history.pushState({}, "", newUrl.toString());
        return sessionId;
    }

    // Copy URL to clipboard
    async function copyUrlToClipboard() {
        try {
            await navigator.clipboard.writeText(window.location.href);
            const btn = document.getElementById("copy-url-btn");
            if (btn) {
                const originalHTML = btn.innerHTML;
                btn.innerHTML = '<i class="ri-check-line"></i> Copied!';
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                }, 2000);
            }
        } catch (e) {
            console.error("Failed to copy URL:", e);
            alert(
                "Failed to copy URL. Please copy manually from the address bar.",
            );
        }
    }

    // Apply flash animation to item
    function flashItem(itemName) {
        const checkbox = document.querySelector(
            `.grocery-item-checkbox[data-item="${itemName}"]`,
        );
        if (!checkbox) return;

        const item = checkbox.closest(".grocery-item");
        if (!item) return;

        item.classList.add("flash");
        setTimeout(() => {
            item.classList.remove("flash");
        }, 600);
    }

    // Handle remote check/uncheck event
    function handleRemoteEvent(payload) {
        const { type, itemName, clientId: remoteClientId } = payload;

        // Ignore our own messages (shouldn't happen with self: false, but just in case)
        if (remoteClientId === clientId) return;

        console.log("📨 Remote event:", type, itemName, "from", remoteClientId);

        const checkbox = document.querySelector(
            `.grocery-item-checkbox[data-item="${itemName}"]`,
        );
        if (!checkbox) return;

        const item = checkbox.closest(".grocery-item");
        if (!item) return;

        // Last event wins: update checkbox and localStorage
        const isChecked = type === "check";
        checkbox.checked = isChecked;

        if (isChecked) {
            checkedItems.add(itemName);
            item.classList.add("checked");
        } else {
            checkedItems.delete(itemName);
            item.classList.remove("checked");
        }

        saveCheckedItems(checkedItems);
        updateCheckedCount(checkedItems.size);

        // Flash animation for visual feedback
        flashItem(itemName);
    }

    // Broadcast check/uncheck event
    function broadcastEvent(type, itemName) {
        if (!realtimeChannel) return;

        const payload = {
            type,
            itemName,
            clientId,
            timestamp: new Date().toISOString(),
        };

        console.log("📤 Broadcasting:", payload);

        realtimeChannel.send({
            type: "broadcast",
            event: "grocery-item",
            payload,
        });
    }

    // Initialize realtime channel
    function initializeRealtime(sessionId) {
        console.log("🚀 Initializing realtime for session:", sessionId);

        const statusElement = document.getElementById("connection-status");
        if (statusElement) {
            statusElement.classList.remove("hidden");
        }

        // Create channel with session ID
        realtimeChannel = supabaseBrowser.channel(
            `grocery-session:${sessionId}`,
            {
                config: {
                    broadcast: {
                        self: false, // Don't receive our own messages
                    },
                },
            },
        );

        // Listen for broadcast messages
        realtimeChannel
            .on("broadcast", { event: "grocery-item" }, (payload) => {
                handleRemoteEvent(payload.payload);
            })
            .subscribe((status) => {
                console.log("📡 Channel status:", status);

                if (status === "SUBSCRIBED") {
                    updateConnectionStatus("connected", "Live");
                } else if (status === "CHANNEL_ERROR") {
                    updateConnectionStatus("disconnected", "Error");
                } else if (status === "TIMED_OUT") {
                    updateConnectionStatus("disconnected", "Timed out");
                } else {
                    updateConnectionStatus("disconnected", "Connecting...");
                }
            });
    }

    // Handle share list button click
    function handleShareList() {
        const sessionId = generateSession();
        initializeRealtime(sessionId);

        // Update UI
        const shareBtn = document.getElementById("share-list-btn");
        const copyBtn = document.getElementById("copy-url-btn");

        if (shareBtn) {
            shareBtn.classList.add("hidden");
        }

        if (copyBtn) {
            copyBtn.classList.remove("hidden");
        }
    }

    // Initialize on page load
    function init() {
        checkedItems = loadCheckedItems();
        const checkboxes = document.querySelectorAll(".grocery-item-checkbox");

        // Restore checked state from localStorage
        checkboxes.forEach((checkbox) => {
            const itemName = checkbox.dataset.item;
            if (itemName && checkedItems.has(itemName)) {
                checkbox.checked = true;
                checkbox.closest(".grocery-item")?.classList.add("checked");
            }
        });

        updateCheckedCount(checkedItems.size);

        // Add event listeners to checkboxes
        checkboxes.forEach((checkbox) => {
            checkbox.addEventListener("change", (e) => {
                const target = e.target;
                const itemName = target.dataset.item;
                const item = target.closest(".grocery-item");

                if (!itemName || !item) return;

                const isChecked = target.checked;

                if (isChecked) {
                    checkedItems.add(itemName);
                    item.classList.add("checked");
                } else {
                    checkedItems.delete(itemName);
                    item.classList.remove("checked");
                }

                saveCheckedItems(checkedItems);
                updateCheckedCount(checkedItems.size);

                // Broadcast to other users if realtime is active
                broadcastEvent(isChecked ? "check" : "uncheck", itemName);
            });
        });

        // Share list button
        const shareBtn = document.getElementById("share-list-btn");
        shareBtn?.addEventListener("click", handleShareList);

        // Copy URL button
        const copyBtn = document.getElementById("copy-url-btn");
        copyBtn?.addEventListener("click", copyUrlToClipboard);

        // Clear checked items button (DEBUG)
        const clearCheckedBtn = document.getElementById("clear-checked");
        clearCheckedBtn?.addEventListener("click", () => {
            const checkedCheckboxes = document.querySelectorAll(
                ".grocery-item-checkbox:checked",
            );
            checkedCheckboxes.forEach((checkbox) => {
                checkbox.checked = false;
                checkbox.closest(".grocery-item")?.classList.remove("checked");
                const itemName = checkbox.dataset.item;
                if (itemName) {
                    checkedItems.delete(itemName);
                    // Broadcast uncheck event
                    broadcastEvent("uncheck", itemName);
                }
            });
            saveCheckedItems(checkedItems);
            updateCheckedCount(0);
        });

        // Reset all button (DEBUG)
        const resetAllBtn = document.getElementById("reset-all");
        resetAllBtn?.addEventListener("click", () => {
            checkboxes.forEach((checkbox) => {
                checkbox.checked = false;
                checkbox.closest(".grocery-item")?.classList.remove("checked");
                const itemName = checkbox.dataset.item;
                if (itemName) {
                    // Broadcast uncheck event
                    broadcastEvent("uncheck", itemName);
                }
            });
            checkedItems.clear();
            saveCheckedItems(checkedItems);
            updateCheckedCount(0);
        });

        // If session ID exists in URL, initialize realtime
        if (sessionParam) {
            initializeRealtime(sessionParam);

            // Update UI to show copy button instead of share button
            const shareBtnElement = document.getElementById("share-list-btn");
            const copyBtnElement = document.getElementById("copy-url-btn");

            if (shareBtnElement) {
                shareBtnElement.classList.add("hidden");
            }

            if (copyBtnElement) {
                copyBtnElement.classList.remove("hidden");
            }
        }
    }

    // Run initialization when DOM is ready
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }

    // Cleanup on page unload
    window.addEventListener("beforeunload", () => {
        if (realtimeChannel) {
            realtimeChannel.unsubscribe();
        }
    });
</script>
