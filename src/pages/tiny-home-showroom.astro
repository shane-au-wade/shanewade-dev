---
import Head from "@components/head.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
import ThemeToggle from "@components/theme-toggle.astro";
import "@styles/components.css";
import "remixicon/fonts/remixicon.css";

const sectionLabel =
    "text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider";
---

<html lang="en">
    <Head title="Tiny Home Showroom - Shane Wade" />
    <body
        class="bg-page dark:bg-dark-bg min-h-screen overflow-hidden font-sans select-none"
    >
        <div id="sr-canvas" class="fixed inset-0 z-0"></div>

        <!-- ── Left panel: generated inventory ─────────────────────────── -->
        <aside
            class="fixed top-4 left-4 z-40 flex flex-col gap-3 p-4 bg-white/92 dark:bg-dark-bg-elevated/92 backdrop-blur-md rounded-xl shadow-lg border border-gray-200 dark:border-dark-border w-64 max-h-[calc(100vh-2rem)]"
        >
            <div class="flex items-center justify-between gap-2">
                <div>
                    <Breadcrumbs />
                    <p class="text-xs text-muted mt-0.5">
                        Every asset in the catalog
                    </p>
                </div>
                <ThemeToggle />
            </div>

            <button
                id="th-palette-open"
                class="flex items-center gap-2 w-full px-2.5 py-1.5 rounded-lg border border-gray-300 dark:border-dark-border bg-gray-50 dark:bg-dark-bg text-muted hover:border-brand-primary transition-colors cursor-pointer"
                title="Search the catalog (Cmd/Ctrl+P)"
            >
                <i class="ri-search-line text-sm"></i>
                <span class="text-xs flex-1 text-left">Find an item...</span>
                <kbd>⌘P</kbd>
            </button>

            <!-- Warehouse stats -->
            <div class="grid grid-cols-3 gap-1.5 text-center">
                <div class="rounded-lg bg-gray-100 dark:bg-dark-bg px-1 py-1.5">
                    <p id="sr-count" class="text-lg font-bold leading-none">0</p>
                    <p class="text-[10px] text-muted mt-0.5">items</p>
                </div>
                <div class="rounded-lg bg-gray-100 dark:bg-dark-bg px-1 py-1.5">
                    <p id="sr-zones" class="text-lg font-bold leading-none">0</p>
                    <p class="text-[10px] text-muted mt-0.5">zones</p>
                </div>
                <div class="rounded-lg bg-gray-100 dark:bg-dark-bg px-1 py-1.5">
                    <p id="sr-size" class="text-sm font-bold leading-none pt-1">
                        —
                    </p>
                    <p class="text-[10px] text-muted mt-0.5">warehouse</p>
                </div>
            </div>

            <div class="flex gap-1.5">
                <button id="sr-overview" class="btn-default btn-sm flex-1">
                    <i class="ri-fullscreen-line"></i> Overview
                </button>
                <button id="sr-spin" class="btn-default btn-sm flex-1">
                    Spin: Off
                </button>
            </div>

            <!-- Item list (generated from the catalog) -->
            <div>
                <p class={`${sectionLabel} mb-1`}>Inventory</p>
                <div
                    id="sr-list"
                    class="overflow-y-auto max-h-[calc(100vh-25rem)] -mx-1"
                >
                </div>
            </div>
        </aside>

        <!-- ── Selected item details ───────────────────────────────────── -->
        <div
            id="sr-details"
            class="hidden fixed top-4 right-4 z-40 w-60 p-4 bg-white/92 dark:bg-dark-bg-elevated/92 backdrop-blur-md rounded-xl shadow-lg border border-gray-200 dark:border-dark-border"
        >
            <p class={sectionLabel}>Now viewing</p>
            <h2 id="sr-name" class="heading-5 mt-1">—</h2>
            <span id="sr-cat" class="badge-primary mt-1.5">—</span>
            <p id="sr-dims" class="text-xs text-muted mt-2">—</p>
            <p class="text-xs text-muted mt-2">
                catalog id: <code id="sr-id" class="text-xs">—</code>
            </p>
            <a href="/tiny-homes" class="btn-outline btn-sm w-full mt-3">
                <i class="ri-hammer-line"></i> Build with it
            </a>
        </div>

        <!-- Hint bar -->
        <div
            class="fixed bottom-4 right-4 z-30 text-xs text-muted bg-white/80 dark:bg-dark-bg-elevated/80 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-gray-200 dark:border-dark-border"
        >
            Click a plinth to inspect · Drag: orbit · Scroll: zoom · <kbd>S</kbd
            > spin · <kbd>Esc</kbd> overview · <kbd>⌘P</kbd> search
        </div>

        <!-- ── Command palette (shared with the builder) ───────────────── -->
        <div id="th-palette" class="hidden fixed inset-0 z-[60]">
            <div
                id="th-palette-backdrop"
                class="absolute inset-0 bg-black/40 backdrop-blur-sm"
            >
            </div>
            <div
                class="relative mx-auto mt-[12vh] w-[min(92vw,34rem)] bg-white dark:bg-dark-bg-elevated rounded-xl shadow-2xl border border-gray-200 dark:border-dark-border overflow-hidden"
            >
                <div
                    class="flex items-center gap-2 px-3 py-2.5 border-b border-gray-200 dark:border-dark-border"
                >
                    <i class="ri-search-line text-muted"></i>
                    <input
                        id="th-palette-input"
                        type="text"
                        autocomplete="off"
                        spellcheck="false"
                        class="flex-1 select-text bg-transparent border-none outline-none text-body placeholder:text-gray-400 dark:placeholder:text-dark-text-muted"
                        placeholder="Search the catalog..."
                    />
                    <kbd>Esc</kbd>
                </div>
                <div
                    id="th-palette-list"
                    class="max-h-[22rem] overflow-y-auto py-1"
                >
                </div>
                <div
                    class="px-3 py-1.5 border-t border-gray-200 dark:border-dark-border text-xs text-muted flex gap-3"
                >
                    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
                    <span><kbd>↵</kbd> jump to item</span>
                </div>
            </div>
        </div>

        <style>
            body {
                overscroll-behavior: none;
            }
            #sr-canvas canvas {
                display: block;
                touch-action: none;
            }
            kbd {
                padding: 0 0.3rem;
                border-radius: 0.25rem;
                background: rgba(0, 0, 0, 0.08);
                font-family: ui-monospace, monospace;
                font-size: 0.9em;
            }
        </style>

        <script>
            import { initShowroom } from "../lib/tinyhome/showroom";

            initShowroom();
        </script>
    </body>
</html>
