# Vercel environment variables for shanewade-dev
# Copy to .env.vercel and fill in real values, then push to Vercel
# (e.g. `vercel env pull` / `vercel env add` or paste in the dashboard).

# --- Supabase (server-side) ---
# Read by src/lib/db/supabase-client.ts
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY=""

# --- Supabase (client-side, exposed to the browser) ---
# Read by src/lib/db/supabase-browser-client.ts
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY=""

# --- Optional ---
# Only used by src/pages/env-test.astro to verify env wiring.
PUBLIC_TEST_VAR="NOW_YOU_SEE_ME"
